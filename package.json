{
  "name": "sjtu-course-downloader",
  "version": "2.5.3",
  "description": "上海交通大学 (SJTU) 课程下载器，批量下载旁听课程视频、Canvas 课件录播与好大学在线，支持交大云盘备份",
  "keywords": [
    "sjtu",
    "shanghai-jiao-tong-university",
    "交大",
    "交大旁听",
    "交大旁听视频下载",
    "交大课程下载",
    "上海交通大学",
    "canvas-downloader",
    "course-downloader",
    "video-downloader",
    "jiaoda",
    "pangting",
    "electron"
  ],
  "main": "out/main/index.js",
  "author": "SJTU Course Downloader Contributors",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/run-electron-vite.mjs dev",
    "build": "npm run typecheck && node scripts/run-electron-vite.mjs build && electron-builder",
    "build:unpack": "npm run typecheck && node scripts/run-electron-vite.mjs build && electron-builder --dir",
    "build:win": "npm run typecheck && node scripts/run-electron-vite.mjs build && electron-builder --win",
    "build:mac": "npm run typecheck && node scripts/run-electron-vite.mjs build && electron-builder --mac",
    "build:linux": "npm run typecheck && node scripts/run-electron-vite.mjs build && electron-builder --linux",
    "icons": "node scripts/generate-icons.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,mjs}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker:start": "node scripts/private-worker-daemon.mjs"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "cheerio": "^1.2.0",
    "ffmpeg-static": "^5.3.0",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "electron": "^39.8.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.4.49",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.62.1",
    "vite": "^7.0.0",
    "vitest": "^4.1.12",
    "zustand": "^5.0.2"
  },
  "overrides": {
    "brace-expansion": "^5.0.12",
    "postcss-selector-parser": "^7.1.6"
  },
  "build": {
    "appId": "edu.sjtu.course-downloader",
    "productName": "SJTU 课程下载器",
    "artifactName": "sjtu-course-downloader-${version}-${os}-${arch}.${ext}",
    "directories": {
      "buildResources": "build",
      "output": "release/${version}"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**"
    ],
    "extraResources": [
      {
        "from": "build/icons",
        "to": "icons",
        "filter": [
          "**/*.png"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "msi"
      ],
      "icon": "build/icons/icon.ico"
    },
    "mac": {
      "identity": null,
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icons/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icons/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "installerIcon": "build/icons/icon.ico",
      "uninstallerIcon": "build/icons/icon.ico"
    },
    "msi": {
      "oneClick": false,
      "perMachine": false,
      "runAfterFinish": true,
      "warningsAsErrors": false,
      "additionalLightArgs": [
        "-cultures:zh-CN"
      ]
    }
  }
}
