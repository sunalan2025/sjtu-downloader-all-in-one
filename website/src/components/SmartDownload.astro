---
import {desktopRelease,androidRelease} from '../utils/releaseInfo';
---
<div class="download-actions" data-desktop={JSON.stringify(desktopRelease)} data-android={JSON.stringify(androidRelease)}>
 <div class="button-row"><a class="button primary" id="recommended-download" href="#downloads">选择你的安装包 <span aria-hidden="true">↓</span></a><a class="button secondary" href="#preview">先看看实际界面 ↗</a></div>
 <p id="download-hint" class="download-hint">桌面版 {desktopRelease.version} · Android {androidRelease.version} · 开源免费</p>
</div>
<script>
 import {detectClientOS} from '../utils/osDetector';
 import {resolveDownloadLink,type PlatformRelease} from '../utils/releaseInfo';
 const root=document.querySelector<HTMLElement>('.download-actions');
 const button=document.querySelector<HTMLAnchorElement>('#recommended-download');
 if(root&&button){const result=resolveDownloadLink(detectClientOS(navigator.userAgent,navigator.maxTouchPoints),JSON.parse(root.dataset.desktop!) as PlatformRelease,JSON.parse(root.dataset.android!) as PlatformRelease);button.href=result.url;button.textContent=result.label+' ↓';document.querySelector('#download-hint')!.textContent=result.detail;}
</script>
