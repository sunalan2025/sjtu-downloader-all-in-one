---
import Icons from './icons/Icons.astro';
import { DEFAULT_FALLBACK_URL } from '../utils/releaseInfo';

export interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
const FALLBACK_VERSION = 'v2.5.0';
---

<div class={`relative w-full max-w-xl mx-auto flex flex-col items-center ${className}`}>
  <!-- Primary Download Actions Row -->
  <div class="w-full flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-3">
    <!-- Main Smart Download Button -->
    <a
      id="smart-download-btn"
      href={DEFAULT_FALLBACK_URL}
      class="group relative flex-1 flex items-center justify-between sm:justify-start gap-3.5 px-6 py-4 rounded-2xl bg-gradient-to-r from-sjtu-navy to-sjtu-blue text-white shadow-xl shadow-sjtu-navy/25 hover:shadow-2xl hover:shadow-sjtu-blue/35 hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.99] transition-all duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-sjtu-blue"
      aria-label="立即下载交大课程下载器客户端"
    >
      <!-- Platform Icon Container -->
      <div class="flex-shrink-0 w-11 h-11 rounded-xl bg-white/15 flex items-center justify-center text-white backdrop-blur-sm group-hover:bg-white/25 transition-colors">
        <span id="icon-windows" class="platform-icon inline-flex">
          <Icons name="windows" class="w-6 h-6" />
        </span>
        <span id="icon-apple" class="platform-icon inline-flex hidden">
          <Icons name="apple" class="w-6 h-6" />
        </span>
        <span id="icon-linux" class="platform-icon inline-flex hidden">
          <Icons name="linux" class="w-6 h-6" />
        </span>
        <span id="icon-default" class="platform-icon inline-flex hidden">
          <Icons name="download" class="w-6 h-6" />
        </span>
      </div>

      <!-- Button Text and Version Subtitle -->
      <div class="flex flex-col text-left">
        <span id="smart-download-text" class="text-base sm:text-lg font-bold tracking-tight text-white flex items-center gap-1.5">
          立即下载 Windows 版 (.exe)
        </span>
        <span id="smart-download-meta" class="text-xs text-blue-100/90 font-medium">
          {FALLBACK_VERSION} 稳定版 · 适用于 Windows 10/11 (64位)
        </span>
      </div>

      <!-- Download Arrow Hint Icon -->
      <div class="hidden sm:flex ml-auto flex-shrink-0 text-white/70 group-hover:text-white group-hover:translate-y-0.5 transition-all">
        <Icons name="download" class="w-5 h-5" />
      </div>
    </a>

    <!-- Dropdown Toggle Button -->
    <button
      id="platform-dropdown-btn"
      type="button"
      class="inline-flex items-center justify-center gap-2 px-5 py-4 rounded-2xl border border-slate-200 dark:border-slate-700/80 bg-white/80 dark:bg-slate-800/80 hover:bg-slate-100 dark:hover:bg-slate-700/80 text-slate-700 dark:text-slate-200 text-sm font-semibold transition-all shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-sjtu-blue cursor-pointer"
      aria-expanded="false"
      aria-haspopup="true"
      aria-controls="platform-dropdown-menu"
      aria-label="查看所有支持平台与安装包格式"
    >
      <span>所有平台与格式</span>
      <span id="platform-dropdown-icon" class="inline-flex transition-transform duration-200">
        <Icons name="chevron-down" class="w-4 h-4" />
      </span>
    </button>
  </div>

  <!-- Dropdown Menu / Drawer (All Platforms & Formats) -->
  <div
    id="platform-dropdown-menu"
    class="hidden absolute top-full left-0 right-0 mt-3 p-4 sm:p-5 rounded-2xl bg-white/95 dark:bg-slate-900/95 backdrop-blur-xl border border-slate-200 dark:border-slate-800 shadow-2xl z-30 animate-in fade-in slide-in-from-top-2 duration-200"
    role="region"
    aria-label="全平台下载安装包列表"
  >
    <div class="text-xs font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-3 px-1">
      选择适合您操作系统的安装版本
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
      <!-- Windows Group -->
      <a
        id="link-win-exe"
        href="https://github.com/sunalan2025/sjtu-downloader-all-in-one/releases/latest"
        class="flex items-center justify-between p-3 rounded-xl border border-slate-100 dark:border-slate-800 hover:border-sjtu-blue/40 bg-slate-50/70 dark:bg-slate-800/50 hover:bg-blue-50/50 dark:hover:bg-slate-800 transition-colors group"
      >
        <div class="flex items-center gap-3">
          <div class="p-2 rounded-lg bg-blue-100 dark:bg-blue-950/60 text-sjtu-navy dark:text-blue-400 group-hover:scale-105 transition-transform">
            <Icons name="windows" class="w-4 h-4" />
          </div>
          <div class="text-left">
            <div class="text-sm font-semibold text-slate-800 dark:text-slate-100 group-hover:text-sjtu-blue transition-colors">
              Windows 安装包 (.exe)
            </div>
            <div class="text-xs text-slate-500 dark:text-slate-400">
              推荐 Win 10 / 11 64位系统
            </div>
          </div>
        </div>
        <span class="asset-size-badge text-[11px] font-mono px-2 py-0.5 rounded-md bg-slate-200/70 dark:bg-slate-700/60 text-slate-600 dark:text-slate-300">
          125.9 MB
        </span>
      </a>

      <a
        id="link-win-msi"
        href="https://github.com/sunalan2025/sjtu-downloader-all-in-one/releases/latest"
        class="flex items-center justify-between p-3 rounded-xl border border-slate-100 dark:border-slate-800 hover:border-sjtu-blue/40 bg-slate-50/70 dark:bg-slate-800/50 hover:bg-blue-50/50 dark:hover:bg-slate-800 transition-colors group"
      >
        <div class="flex items-center gap-3">
          <div class="p-2 rounded-lg bg-blue-100 dark:bg-blue-950/60 text-sjtu-navy dark:text-blue-400 group-hover:scale-105 transition-transform">
            <Icons name="windows" class="w-4 h-4" />
          </div>
          <div class="text-left">
            <div class="text-sm font-semibold text-slate-800 dark:text-slate-100 group-hover:text-sjtu-blue transition-colors">
              Windows 便携 / MSI (.msi)
            </div>
            <div class="text-xs text-slate-500 dark:text-slate-400">
              免管理员权限 / 专用机房
            </div>
          </div>
        </div>
        <span class="asset-size-badge text-[11px] font-mono px-2 py-0.5 rounded-md bg-slate-200/70 dark:bg-slate-700/60 text-slate-600 dark:text-slate-300">
          133.3 MB
        </span>
      </a>

      <!-- macOS Group -->
      <a
        id="link-mac-arm"
        href="https://github.com/sunalan2025/sjtu-downloader-all-in-one/releases/latest"
        class="flex items-center justify-between p-3 rounded-xl border border-slate-100 dark:border-slate-800 hover:border-sjtu-blue/40 bg-slate-50/70 dark:bg-slate-800/50 hover:bg-blue-50/50 dark:hover:bg-slate-800 transition-colors group"
      >
        <div class="flex items-center gap-3">
          <div class="p-2 rounded-lg bg-slate-200/80 dark:bg-slate-800 text-slate-800 dark:text-slate-200 group-hover:scale-105 transition-transform">
            <Icons name="apple" class="w-4 h-4" />
          </div>
          <div class="text-left">
            <div class="text-sm font-semibold text-slate-800 dark:text-slate-100 group-hover:text-sjtu-blue transition-colors">
              macOS Apple Silicon (.dmg)
            </div>
            <div class="text-xs text-slate-500 dark:text-slate-400">
              专为 M1/M2/M3/M4 原生加速
            </div>
          </div>
        </div>
        <span class="asset-size-badge text-[11px] font-mono px-2 py-0.5 rounded-md bg-slate-200/70 dark:bg-slate-700/60 text-slate-600 dark:text-slate-300">
          135.7 MB
        </span>
      </a>

      <a
        id="link-mac-intel"
        href="https://github.com/sunalan2025/sjtu-downloader-all-in-one/releases/latest"
        class="flex items-center justify-between p-3 rounded-xl border border-slate-100 dark:border-slate-800 hover:border-sjtu-blue/40 bg-slate-50/70 dark:bg-slate-800/50 hover:bg-blue-50/50 dark:hover:bg-slate-800 transition-colors group"
      >
        <div class="flex items-center gap-3">
          <div class="p-2 rounded-lg bg-slate-200/80 dark:bg-slate-800 text-slate-800 dark:text-slate-200 group-hover:scale-105 transition-transform">
            <Icons name="apple" class="w-4 h-4" />
          </div>
          <div class="text-left">
            <div class="text-sm font-semibold text-slate-800 dark:text-slate-100 group-hover:text-sjtu-blue transition-colors">
              macOS Intel 芯片 (.dmg)
            </div>
            <div class="text-xs text-slate-500 dark:text-slate-400">
              适用 Intel 架构 Mac 设备
            </div>
          </div>
        </div>
        <span class="asset-size-badge text-[11px] font-mono px-2 py-0.5 rounded-md bg-slate-200/70 dark:bg-slate-700/60 text-slate-600 dark:text-slate-300">
          130.5 MB
        </span>
      </a>

      <!-- Linux Group -->
      <a
        id="link-linux-appimage"
        href="https://github.com/sunalan2025/sjtu-downloader-all-in-one/releases/latest"
        class="flex items-center justify-between p-3 rounded-xl border border-slate-100 dark:border-slate-800 hover:border-sjtu-blue/40 bg-slate-50/70 dark:bg-slate-800/50 hover:bg-blue-50/50 dark:hover:bg-slate-800 transition-colors group"
      >
        <div class="flex items-center gap-3">
          <div class="p-2 rounded-lg bg-amber-100 dark:bg-amber-950/50 text-amber-600 dark:text-amber-400 group-hover:scale-105 transition-transform">
            <Icons name="linux" class="w-4 h-4" />
          </div>
          <div class="text-left">
            <div class="text-sm font-semibold text-slate-800 dark:text-slate-100 group-hover:text-sjtu-blue transition-colors">
              Linux 通用镜像 (.AppImage)
            </div>
            <div class="text-xs text-slate-500 dark:text-slate-400">
              适用 Ubuntu, Debian, Fedora, Arch
            </div>
          </div>
        </div>
        <span class="asset-size-badge text-[11px] font-mono px-2 py-0.5 rounded-md bg-slate-200/70 dark:bg-slate-700/60 text-slate-600 dark:text-slate-300">
          147.5 MB
        </span>
      </a>

      <!-- GitHub Releases Link -->
      <a
        href="https://github.com/sunalan2025/sjtu-downloader-all-in-one/releases"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-between p-3 rounded-xl border border-slate-100 dark:border-slate-800 hover:border-sjtu-blue/40 bg-slate-50/70 dark:bg-slate-800/50 hover:bg-blue-50/50 dark:hover:bg-slate-800 transition-colors group"
      >
        <div class="flex items-center gap-3">
          <div class="p-2 rounded-lg bg-purple-100 dark:bg-purple-950/50 text-purple-600 dark:text-purple-400 group-hover:scale-105 transition-transform">
            <Icons name="github" class="w-4 h-4" />
          </div>
          <div class="text-left">
            <div class="text-sm font-semibold text-slate-800 dark:text-slate-100 group-hover:text-sjtu-blue transition-colors">
              历史版本与更新日志
            </div>
            <div class="text-xs text-slate-500 dark:text-slate-400">
              前往 GitHub Releases 查看全部发布记录
            </div>
          </div>
        </div>
        <Icons name="external-link" class="w-4 h-4 text-slate-400 group-hover:text-sjtu-blue transition-colors" />
      </a>
    </div>
  </div>

  <!-- Micro-trust Indicators (Security, JAccount, Compatibility) -->
  <div class="mt-4 text-xs text-slate-500 dark:text-slate-400 font-medium text-center">
    v2.5.0 · 支持 Windows / macOS / Linux · MIT 开源
  </div>
</div>

<script>
  import { detectClientOS, type ClientOSInfo } from '../utils/osDetector';
  import { resolveDownloadLink, type GitHubRelease } from '../utils/releaseInfo';

  function initSmartDownload() {
    const downloadBtn = document.getElementById('smart-download-btn') as HTMLAnchorElement | null;
    const downloadText = document.getElementById('smart-download-text');
    const downloadMeta = document.getElementById('smart-download-meta');
    const dropdownBtn = document.getElementById('platform-dropdown-btn') as HTMLButtonElement | null;
    const dropdownMenu = document.getElementById('platform-dropdown-menu');
    const dropdownIcon = document.getElementById('platform-dropdown-icon');

    if (!downloadBtn || !downloadText || !downloadMeta) return;

    // 1. Detect OS
    const osInfo: ClientOSInfo = detectClientOS(navigator.userAgent);

    // Switch Icon
    const iconWindows = document.getElementById('icon-windows');
    const iconApple = document.getElementById('icon-apple');
    const iconLinux = document.getElementById('icon-linux');
    const iconDefault = document.getElementById('icon-default');

    function showIcon(target: HTMLElement | null) {
      [iconWindows, iconApple, iconLinux, iconDefault].forEach((el) => {
        if (el) el.classList.add('hidden');
      });
      if (target) target.classList.remove('hidden');
    }

    // Dynamic initial text based on detected OS
    let defaultLabel = 'Windows 版 (.exe)';
    let defaultMeta = 'v2.5.0 稳定版 · 适用于 Windows 10/11 (64位)';

    if (osInfo.os === 'mac') {
      showIcon(iconApple);
      const archLabel = osInfo.arch === 'arm64' ? 'Apple Silicon' : 'Intel 芯片';
      defaultLabel = `macOS 版 (${archLabel} .dmg)`;
      defaultMeta = `v2.5.0 稳定版 · 适用于 macOS 11+ (${archLabel})`;
    } else if (osInfo.os === 'linux') {
      showIcon(iconLinux);
      defaultLabel = 'Linux 版 (.AppImage)';
      defaultMeta = 'v2.5.0 稳定版 · 适用于主流 Linux 64位系统';
    } else if (osInfo.os === 'windows') {
      showIcon(iconWindows);
      defaultLabel = 'Windows 版 (.exe)';
      defaultMeta = 'v2.5.0 稳定版 · 适用于 Windows 10/11 (64位)';
    } else {
      showIcon(iconDefault);
      defaultLabel = '客户端 (选择适用平台)';
      defaultMeta = 'v2.5.0 稳定版 · 支持 Windows / macOS / Linux';
    }

    downloadText.textContent = `立即下载 ${defaultLabel}`;
    downloadMeta.textContent = defaultMeta;

    // 2. Quietly Fetch GitHub Latest Release
    fetch('https://api.github.com/repos/sunalan2025/sjtu-downloader-all-in-one/releases/latest')
      .then((res) => {
        if (!res.ok) return null;
        return res.json() as Promise<GitHubRelease>;
      })
      .then((release) => {
        if (!release) return;

        const resolved = resolveDownloadLink(release, osInfo, '2.5.0');
        if (resolved.url) {
          downloadBtn.href = resolved.url;
        }

        const sizeText = resolved.sizeMb ? ` · 约 ${resolved.sizeMb} MB` : '';
        const sysText =
          osInfo.os === 'mac'
            ? `macOS 11+ (${osInfo.arch === 'arm64' ? 'Apple Silicon' : 'Intel'})`
            : osInfo.os === 'linux'
              ? 'Linux 64位'
              : 'Windows 10/11 (64位)';

        downloadMeta.textContent = `最新 ${resolved.version}${sizeText} · 适用于 ${sysText}`;

        // Update dropdown links with real asset URLs and sizes if present
        if (release.assets && release.assets.length > 0) {
          const updateLink = (id: string, matchFn: (name: string) => boolean) => {
            const linkEl = document.getElementById(id) as HTMLAnchorElement | null;
            if (linkEl) {
              const asset = release.assets.find((a) => matchFn(a.name.toLowerCase()));
              if (asset) {
                linkEl.href = asset.browser_download_url;
                const sizeMb = Math.round((asset.size / (1024 * 1024)) * 10) / 10;
                const badgeEl = linkEl.querySelector('.asset-size-badge');
                if (badgeEl) {
                  badgeEl.textContent = `${sizeMb} MB`;
                }
              }
            }
          };

          updateLink(
            'link-win-exe',
            (name) =>
              name.endsWith('.exe') &&
              !name.includes('blockmap') &&
              !name.includes('elevate') &&
              !name.includes('ffmpeg')
          );
          updateLink('link-win-msi', (name) => name.endsWith('.msi') || (name.endsWith('.zip') && name.includes('win')));
          updateLink('link-mac-arm', (name) => name.endsWith('.dmg') && (name.includes('arm64') || name.includes('aarch64')));
          updateLink('link-mac-intel', (name) => name.endsWith('.dmg') && !name.includes('arm64') && !name.includes('aarch64'));
          updateLink('link-linux-appimage', (name) => name.endsWith('.appimage'));
        }
      })
      .catch(() => {
        // Quietly fallback without throwing
      });

    // 3. Dropdown Menu Toggle Logic
    if (dropdownBtn && dropdownMenu) {
      const toggleMenu = (open?: boolean) => {
        const isCurrentlyOpen = dropdownBtn.getAttribute('aria-expanded') === 'true';
        const nextState = open !== undefined ? open : !isCurrentlyOpen;

        dropdownBtn.setAttribute('aria-expanded', String(nextState));
        if (nextState) {
          dropdownMenu.classList.remove('hidden');
          dropdownIcon?.classList.add('rotate-180');
        } else {
          dropdownMenu.classList.add('hidden');
          dropdownIcon?.classList.remove('rotate-180');
        }
      };

      dropdownBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleMenu();
      });

      // Close on clicking anywhere outside
      document.addEventListener('click', (e) => {
        if (!dropdownMenu.contains(e.target as Node) && !dropdownBtn.contains(e.target as Node)) {
          toggleMenu(false);
        }
      });

      // Close on ESC key
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          toggleMenu(false);
        }
      });
    }
  }

  // Initial execution
  initSmartDownload();
  // Support Astro View Transitions if enabled
  document.addEventListener('astro:page-load', initSmartDownload);
</script>
