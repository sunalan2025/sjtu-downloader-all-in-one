---
import {desktopRelease} from '../utils/releaseInfo';
const macAnswer=desktopRelease.assets.some(a=>a.platform==='mac'&&a.arch==='x64')?'扩展名不能说明芯片类型，请按安装包标注的 arm64（Apple Silicon）或 x64（Intel）选择。':`不是。当前 ${desktopRelease.version} 的 macOS 安装包均为 arm64，适用于 Apple Silicon。不要只根据扩展名判断处理器架构。`;
const faqs=[
 ['校外使用需要校园网吗？','部分录播、课件和教务数据受学校网络或授权限制。校外请按需要连接交大 VPN。桌面端也可自行配置校内节点进行远端传输，具体见文档。'],
 ['文件保存在哪里？','首次使用向导和“设置 → 存储与下载”中可以确认或修改目录。下载前也请确认是本地、云盘还是双份保存。'],
 ['Mac 的 ZIP 是 Intel 版吗？',macAnswer],
 ['所有任务都能断点续传吗？','不能统一保证。暂停、恢复与跨重启恢复取决于来源和传输方式，可在传输中心查看状态，在“资源库 → 任务恢复”处理可恢复任务。'],
 ['桌面端和安卓端功能一样吗？','两者分别开发与发布。安卓端提供课程文件下载、日历、提醒与桌面组件；完整的旁听、好大学在线和交大云盘管理目前在桌面端。'],
 ['系统提示未识别的应用怎么办？','先确认文件来自本仓库正式发布，必要时核对 SHA256。桌面端未购买商业代码签名；安卓沿用历史公开签名以保持升级兼容。请在确认来源后按系统提示安装。']
];
---
<section id="faq" class="container section faq-section"><div class="section-heading"><div><p class="eyebrow">你可能还想知道</p><h2>常见问题。</h2></div></div><div class="faq-list">{faqs.map(([question,answer])=><details><summary>{question}<span aria-hidden="true">＋</span></summary><p>{answer}</p></details>)}</div></section>
