---
import Icons from './icons/Icons.astro';
import SmartDownload from './SmartDownload.astro';
import AppPreview from './AppPreview.astro';

export interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<section
  id="hero"
  class={`relative pt-10 pb-16 sm:pt-14 sm:pb-24 lg:pt-16 lg:pb-28 overflow-hidden ${className}`}
  aria-label="SJTU 课程下载器产品介绍首屏"
>
  <!-- Background Glow & Decorative Accents -->
  <div
    class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-[420px] bg-gradient-to-b from-sjtu-blue/15 via-sjtu-navy/5 to-transparent blur-3xl pointer-events-none -z-10"
    aria-hidden="true"
  ></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col items-center text-center">
    <!-- Top Announcement Pill -->
    <a
      href="#download"
      class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-blue-50/90 dark:bg-blue-950/70 border border-blue-200/80 dark:border-blue-800/70 text-sjtu-navy dark:text-blue-300 shadow-sm hover:border-sjtu-blue/50 dark:hover:border-blue-700 hover:bg-blue-100/70 dark:hover:bg-blue-900/60 transition-all duration-200 mb-6 group"
    >
      <span class="flex h-2 w-2 relative">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-sjtu-blue opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-sjtu-blue"></span>
      </span>
      <span>v2.5.0 全新发布</span>
      <span class="text-slate-300 dark:text-slate-700">|</span>
      <span class="text-slate-600 dark:text-slate-300 font-medium group-hover:text-sjtu-blue transition-colors">
        深度集成交大云盘双向存储与原生全平台适配 ›
      </span>
    </a>

    <!-- Eye-catching Headline -->
    <h1
      class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-900 dark:text-white leading-[1.18] sm:leading-[1.16] max-w-5xl"
    >
      专为上海交通大学师生打造的<br class="hidden sm:inline" />
      <span class="bg-gradient-to-r from-sjtu-navy via-sjtu-blue to-sjtu-cyan bg-clip-text text-transparent">
        课程资源与知识归档工具
      </span>
    </h1>

    <!-- Subtitle -->
    <p
      class="mt-5 sm:mt-6 max-w-3xl text-base sm:text-lg lg:text-xl text-slate-600 dark:text-slate-300 leading-relaxed font-normal"
    >
      一站式批量下载与备份 Canvas 课件录播、旁听课程视频、好大学在线，深度集成交大云盘双向存储
    </p>

    <!-- Smart Download CTA Zone -->
    <div class="mt-8 sm:mt-10 w-full flex justify-center">
      <SmartDownload />
    </div>

    <!-- Feature Pill Badges -->
    <div class="mt-8 flex flex-wrap items-center justify-center gap-2 sm:gap-3 max-w-4xl">
      <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium bg-slate-100/80 dark:bg-slate-800/80 text-slate-700 dark:text-slate-300 border border-slate-200/60 dark:border-slate-700/60">
        <Icons name="book-open" class="w-3.5 h-3.5 text-sjtu-blue" />
        <span>Canvas 课件录播自动归档</span>
      </div>
      <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium bg-slate-100/80 dark:bg-slate-800/80 text-slate-700 dark:text-slate-300 border border-slate-200/60 dark:border-slate-700/60">
        <Icons name="cloud" class="w-3.5 h-3.5 text-emerald-500" />
        <span>交大云盘一键上传备份</span>
      </div>
      <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium bg-slate-100/80 dark:bg-slate-800/80 text-slate-700 dark:text-slate-300 border border-slate-200/60 dark:border-slate-700/60">
        <Icons name="shield" class="w-3.5 h-3.5 text-purple-500" />
        <span>JAccount 统一安全认证</span>
      </div>
      <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium bg-slate-100/80 dark:bg-slate-800/80 text-slate-700 dark:text-slate-300 border border-slate-200/60 dark:border-slate-700/60">
        <Icons name="sparkles" class="w-3.5 h-3.5 text-amber-500" />
        <span>Aria2 16线程超速引擎</span>
      </div>
    </div>

    <!-- Realistic App Mockup Showcase -->
    <div class="mt-12 sm:mt-16 w-full">
      <AppPreview />
    </div>
  </div>
</section>
