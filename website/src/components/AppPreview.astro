---
import Icons from './icons/Icons.astro';

export interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class={`relative w-full max-w-6xl mx-auto px-2 sm:px-4 ${className}`} id="app-preview-container">
  <!-- Glowing Ambient Aura (Backlight Layer) -->
  <div
    class="absolute -inset-1 sm:-inset-2 bg-gradient-to-r from-sjtu-navy/35 via-sjtu-blue/30 to-sjtu-cyan/25 rounded-3xl blur-2xl sm:blur-3xl opacity-70 dark:opacity-50 -z-10 pointer-events-none transition-opacity duration-500"
    aria-hidden="true"
  ></div>

  <!-- Perspective Window Container -->
  <div
    class="relative rounded-2xl sm:rounded-3xl border border-slate-200/90 dark:border-slate-700/80 bg-white/95 dark:bg-[#070B14]/95 backdrop-blur-2xl shadow-2xl shadow-sjtu-navy/15 dark:shadow-black/70 overflow-hidden text-slate-800 dark:text-slate-100 transition-all duration-300"
  >
    <!-- ① macOS 真实 TitleBar 1:1 复刻 -->
    <header
      class="h-14 px-3 sm:px-4 bg-slate-100/90 dark:bg-slate-900/90 border-b border-slate-200/80 dark:border-slate-800/80 flex items-center justify-between select-none gap-2 sm:gap-4 overflow-x-auto no-scrollbar"
    >
      <!-- Traffic Light Buttons -->
      <div class="flex items-center gap-2 shrink-0">
        <span class="w-3 h-3 rounded-full bg-[#FF5F56] border border-[#E0443E]/50 shadow-inner"></span>
        <span class="w-3 h-3 rounded-full bg-[#FFBD2E] border border-[#DEA123]/50 shadow-inner"></span>
        <span class="w-3 h-3 rounded-full bg-[#27C93F] border border-[#1AAB29]/50 shadow-inner"></span>
      </div>

      <!-- Segmented Control: 真实客户端四大核心主栏目 -->
      <nav class="flex items-center p-1 rounded-xl bg-slate-200/70 dark:bg-slate-800/80 border border-slate-300/50 dark:border-slate-700/60 shadow-inner shrink-0" role="tablist" aria-label="客户端四大核心栏目">
        <button
          type="button"
          role="tab"
          id="tab-btn-canvas"
          data-target="pane-canvas"
          aria-selected="true"
          class="sim-tab-btn px-3 py-1.5 rounded-lg text-xs font-bold transition-all shadow-sm bg-white dark:bg-slate-700 text-sjtu-blue dark:text-blue-400 flex items-center gap-1.5 cursor-pointer"
        >
          <Icons name="book-open" class="w-3.5 h-3.5" />
          <span>Canvas 课程</span>
        </button>
        <button
          type="button"
          role="tab"
          id="tab-btn-audited"
          data-target="pane-audited"
          aria-selected="false"
          class="sim-tab-btn px-3 py-1.5 rounded-lg text-xs font-medium text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 transition-all flex items-center gap-1.5 cursor-pointer"
        >
          <Icons name="video" class="w-3.5 h-3.5" />
          <span>旁听课程</span>
        </button>
        <button
          type="button"
          role="tab"
          id="tab-btn-cnmooc"
          data-target="pane-cnmooc"
          aria-selected="false"
          class="sim-tab-btn px-3 py-1.5 rounded-lg text-xs font-medium text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 transition-all flex items-center gap-1.5 cursor-pointer"
        >
          <Icons name="graduation-cap" class="w-3.5 h-3.5" />
          <span>好大学在线</span>
        </button>
        <button
          type="button"
          role="tab"
          id="tab-btn-schedule"
          data-target="pane-schedule"
          aria-selected="false"
          class="sim-tab-btn px-3 py-1.5 rounded-lg text-xs font-medium text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 transition-all flex items-center gap-1.5 cursor-pointer"
        >
          <span class="text-xs">📅</span>
          <span>课表与日程</span>
          <span class="px-1.5 py-0.2 rounded-full text-[9px] font-bold bg-amber-500/20 text-amber-600 dark:text-amber-400">DDL</span>
        </button>
      </nav>

      <!-- 真实右侧状态胶囊：交大云盘配额 + 动态流速看板 + 用户 -->
      <div class="flex items-center gap-2 shrink-0">
        <!-- 云盘配额胶囊 -->
        <div class="hidden lg:flex items-center gap-2 px-2.5 py-1 rounded-xl bg-blue-50/80 dark:bg-blue-950/40 border border-blue-200/60 dark:border-blue-900/50 text-xs text-blue-900 dark:text-blue-300" title="交大云盘容量状态">
          <Icons name="cloud" class="w-3.5 h-3.5 text-sjtu-blue" />
          <span class="font-medium">18.2 GB / 100 GB</span>
          <div class="w-10 h-1.5 rounded-full bg-blue-200 dark:bg-blue-800 overflow-hidden">
            <div class="h-full bg-sjtu-blue rounded-full" style="width: 18%"></div>
          </div>
        </div>

        <!-- 传输速度看板 -->
        <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200/60 dark:border-emerald-900/50 text-xs text-emerald-800 dark:text-emerald-300">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <span class="font-mono font-medium">📥 3 项 · 12.8 MB/s</span>
        </div>

        <!-- 用户头像 -->
        <div class="w-7 h-7 rounded-lg bg-gradient-to-tr from-sjtu-navy to-sjtu-blue text-white flex items-center justify-center text-xs font-bold shadow-sm">
          S
        </div>
      </div>
    </header>

    <!-- ② 真实次级工具栏 SubBar -->
    <div class="px-4 py-2.5 bg-slate-50/80 dark:bg-slate-900/50 border-b border-slate-200/70 dark:border-slate-800/70 flex flex-wrap items-center justify-between gap-3 text-xs">
      <div class="flex items-center gap-2 flex-wrap">
        <!-- 学期下拉选择器 -->
        <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 font-medium text-slate-800 dark:text-slate-200 shadow-2xs">
          <span>2025-2026 秋季学期</span>
          <Icons name="chevron-down" class="w-3 h-3 text-slate-400" />
        </div>

        <!-- 搜索框 -->
        <div class="relative w-48 sm:w-64">
          <input
            type="text"
            readonly
            value=""
            placeholder="搜索课程名称、课号或主讲教师..."
            class="w-full pl-8 pr-3 py-1.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 placeholder-slate-400 text-xs focus:outline-none"
          />
          <svg class="w-3.5 h-3.5 text-slate-400 absolute left-2.5 top-1/2 -translate-y-1/2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        </div>

        <!-- 刷新按钮 -->
        <button type="button" class="p-1.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-500 hover:text-slate-900 dark:hover:text-slate-100 transition-colors" title="重新获取课程列表">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 0 1 15-6.7L21 8M21 3v5h-5M21 12a9 9 0 0 1-15 6.7L3 16M3 21v-5h5"/></svg>
        </button>
      </div>

      <!-- 三重视图自由切换 (网格 / 列表 / 分栏) -->
      <div class="flex items-center gap-1 p-0.5 rounded-xl bg-slate-200/80 dark:bg-slate-800 border border-slate-300/60 dark:border-slate-700">
        <button
          type="button"
          id="view-btn-grid"
          data-view="grid"
          class="sim-view-btn px-2.5 py-1 rounded-lg font-medium text-xs bg-white dark:bg-slate-700 text-sjtu-blue dark:text-blue-400 shadow-2xs flex items-center gap-1 cursor-pointer"
          title="网格大图标视图"
        >
          <span>⊞</span>
          <span>网格</span>
        </button>
        <button
          type="button"
          id="view-btn-list"
          data-view="list"
          class="sim-view-btn px-2.5 py-1 rounded-lg font-medium text-xs text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 flex items-center gap-1 cursor-pointer"
          title="详细列表视图"
        >
          <span>☰</span>
          <span>列表</span>
        </button>
        <button
          type="button"
          id="view-btn-column"
          data-view="column"
          class="sim-view-btn px-2.5 py-1 rounded-lg font-medium text-xs text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 flex items-center gap-1 cursor-pointer"
          title="三栏分栏 Miller Columns 视图"
        >
          <span>◫</span>
          <span>分栏</span>
        </button>
      </div>
    </div>

    <!-- ③ 真实主工作区 (根据 Tab 动态切换) -->
    <main class="relative min-h-[460px] p-4 sm:p-6 pb-28 overflow-hidden bg-slate-50/40 dark:bg-[#070B14]">
      
      <!-- PANE 1: Canvas 课程 -->
      <div id="pane-canvas" class="sim-pane space-y-4">
        <!-- 网格视图容器 (默认) -->
        <div id="canvas-grid-view" class="sim-canvas-view grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
          <!-- 课程卡片 1 -->
          <div class="rounded-2xl border-2 border-sjtu-blue bg-white dark:bg-slate-900/90 p-4 shadow-md shadow-sjtu-blue/10 relative group transition-all">
            <div class="flex items-start justify-between gap-2">
              <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-blue-100 dark:bg-blue-900/60 text-sjtu-blue dark:text-blue-300 font-mono">CSE5001</span>
              <div class="w-5 h-5 rounded-md bg-sjtu-blue text-white flex items-center justify-center text-xs">✓</div>
            </div>
            <h4 class="font-bold text-sm text-slate-900 dark:text-slate-100 mt-2 line-clamp-1">高级算法设计与分析</h4>
            <p class="text-xs text-slate-500 mt-0.5">计算机科学与技术 · 3.0 学分</p>
            <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800 grid grid-cols-3 gap-1 text-[11px] text-center text-slate-600 dark:text-slate-400">
              <div class="bg-slate-50 dark:bg-slate-800/60 py-1 rounded-lg">
                <span class="font-bold block text-slate-900 dark:text-slate-100">38</span>
                <span>课件资料</span>
              </div>
              <div class="bg-slate-50 dark:bg-slate-800/60 py-1 rounded-lg">
                <span class="font-bold block text-slate-900 dark:text-slate-100">16 讲</span>
                <span>双路录播</span>
              </div>
              <div class="bg-slate-50 dark:bg-slate-800/60 py-1 rounded-lg">
                <span class="font-bold block text-amber-600 dark:text-amber-400">2 项</span>
                <span>待交作业</span>
              </div>
            </div>
          </div>

          <!-- 课程卡片 2 -->
          <div class="rounded-2xl border-2 border-sjtu-blue bg-white dark:bg-slate-900/90 p-4 shadow-md shadow-sjtu-blue/10 relative group transition-all">
            <div class="flex items-start justify-between gap-2">
              <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-indigo-100 dark:bg-indigo-900/60 text-indigo-700 dark:text-indigo-300 font-mono">SE3353</span>
              <div class="w-5 h-5 rounded-md bg-sjtu-blue text-white flex items-center justify-center text-xs">✓</div>
            </div>
            <h4 class="font-bold text-sm text-slate-900 dark:text-slate-100 mt-2 line-clamp-1">软件工程与系统架构</h4>
            <p class="text-xs text-slate-500 mt-0.5">软件工程核心 · 3.0 学分</p>
            <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800 grid grid-cols-3 gap-1 text-[11px] text-center text-slate-600 dark:text-slate-400">
              <div class="bg-slate-50 dark:bg-slate-800/60 py-1 rounded-lg">
                <span class="font-bold block text-slate-900 dark:text-slate-100">45</span>
                <span>课件资料</span>
              </div>
              <div class="bg-slate-50 dark:bg-slate-800/60 py-1 rounded-lg">
                <span class="font-bold block text-slate-900 dark:text-slate-100">18 讲</span>
                <span>PPT导出</span>
              </div>
              <div class="bg-slate-50 dark:bg-slate-800/60 py-1 rounded-lg">
                <span class="font-bold block text-emerald-600 dark:text-emerald-400">全部</span>
                <span>已提交</span>
              </div>
            </div>
          </div>

          <!-- 课程卡片 3 -->
          <div class="rounded-2xl border-2 border-sjtu-blue bg-white dark:bg-slate-900/90 p-4 shadow-md shadow-sjtu-blue/10 relative group transition-all">
            <div class="flex items-start justify-between gap-2">
              <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-cyan-100 dark:bg-cyan-900/60 text-cyan-800 dark:text-cyan-300 font-mono">CS3502</span>
              <div class="w-5 h-5 rounded-md bg-sjtu-blue text-white flex items-center justify-center text-xs">✓</div>
            </div>
            <h4 class="font-bold text-sm text-slate-900 dark:text-slate-100 mt-2 line-clamp-1">操作系统与分布式系统</h4>
            <p class="text-xs text-slate-500 mt-0.5">计算机科学与技术 · 4.0 学分</p>
            <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800 grid grid-cols-3 gap-1 text-[11px] text-center text-slate-600 dark:text-slate-400">
              <div class="bg-slate-50 dark:bg-slate-800/60 py-1 rounded-lg">
                <span class="font-bold block text-slate-900 dark:text-slate-100">62</span>
                <span>课件资料</span>
              </div>
              <div class="bg-slate-50 dark:bg-slate-800/60 py-1 rounded-lg">
                <span class="font-bold block text-slate-900 dark:text-slate-100">24 讲</span>
                <span>双机位超清</span>
              </div>
              <div class="bg-slate-50 dark:bg-slate-800/60 py-1 rounded-lg">
                <span class="font-bold block text-slate-900 dark:text-slate-100">已备好</span>
                <span>云盘直传</span>
              </div>
            </div>
          </div>

          <!-- 课程卡片 4 -->
          <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/60 p-4 relative group opacity-75 hover:opacity-100 transition-all">
            <div class="flex items-start justify-between gap-2">
              <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 font-mono">MATH1205</span>
              <div class="w-5 h-5 rounded-md border border-slate-300 dark:border-slate-700"></div>
            </div>
            <h4 class="font-bold text-sm text-slate-900 dark:text-slate-100 mt-2 line-clamp-1">概率论与数理统计</h4>
            <p class="text-xs text-slate-500 mt-0.5">数学科学学院 · 4.0 学分</p>
            <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800 grid grid-cols-3 gap-1 text-[11px] text-center text-slate-600 dark:text-slate-400">
              <div class="bg-slate-50 dark:bg-slate-800/60 py-1 rounded-lg">
                <span class="font-bold block text-slate-900 dark:text-slate-100">28</span>
                <span>课件资料</span>
              </div>
              <div class="bg-slate-50 dark:bg-slate-800/60 py-1 rounded-lg">
                <span class="font-bold block text-slate-900 dark:text-slate-100">14 讲</span>
                <span>录播切片</span>
              </div>
              <div class="bg-slate-50 dark:bg-slate-800/60 py-1 rounded-lg">
                <span class="font-bold block text-slate-500">免考</span>
                <span>已归档</span>
              </div>
            </div>
          </div>
        </div>

        <!-- 详细列表视图容器 -->
        <div id="canvas-list-view" class="sim-canvas-view hidden rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 overflow-hidden text-xs">
          <table class="w-full text-left">
            <thead class="bg-slate-50 dark:bg-slate-800/60 text-slate-500 font-semibold border-b border-slate-200 dark:border-slate-800">
              <tr>
                <th class="p-3 w-8"><input type="checkbox" checked readonly class="rounded" /></th>
                <th class="p-3">课程代码与名称</th>
                <th class="p-3">教学开课单位</th>
                <th class="p-3">课件数量</th>
                <th class="p-3">录播状态</th>
                <th class="p-3">预计体积</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
              <tr class="bg-blue-50/40 dark:bg-blue-950/20">
                <td class="p-3"><input type="checkbox" checked readonly /></td>
                <td class="p-3 font-bold text-slate-900 dark:text-slate-100">CSE5001 高级算法设计与分析</td>
                <td class="p-3 text-slate-500">计算机科学与工程系</td>
                <td class="p-3">38 份 PDF 课件</td>
                <td class="p-3 text-emerald-600 dark:text-emerald-400">16 讲 (双路超清视频)</td>
                <td class="p-3 font-mono font-medium">1.42 GB</td>
              </tr>
              <tr class="bg-blue-50/40 dark:bg-blue-950/20">
                <td class="p-3"><input type="checkbox" checked readonly /></td>
                <td class="p-3 font-bold text-slate-900 dark:text-slate-100">SE3353 软件工程与系统架构</td>
                <td class="p-3 text-slate-500">软件学院核心教学组</td>
                <td class="p-3">45 份 PDF / 讲义</td>
                <td class="p-3 text-emerald-600 dark:text-emerald-400">18 讲 (含高清PPT合成)</td>
                <td class="p-3 font-mono font-medium">1.18 GB</td>
              </tr>
              <tr class="bg-blue-50/40 dark:bg-blue-950/20">
                <td class="p-3"><input type="checkbox" checked readonly /></td>
                <td class="p-3 font-bold text-slate-900 dark:text-slate-100">CS3502 操作系统与分布式系统</td>
                <td class="p-3 text-slate-500">计算机科学与工程系</td>
                <td class="p-3">62 份 讲义与实验材料</td>
                <td class="p-3 text-emerald-600 dark:text-emerald-400">24 讲 (教师视角/PPT视角)</td>
                <td class="p-3 font-mono font-medium">1.24 GB</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- 三栏分栏 (Miller Columns) 视图容器 -->
        <div id="canvas-column-view" class="sim-canvas-view hidden rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 overflow-hidden text-xs h-[300px] grid grid-cols-3 divide-x divide-slate-200 dark:divide-slate-800">
          <div class="p-2 space-y-1 overflow-y-auto">
            <div class="px-2 py-1 text-[10px] font-bold text-slate-400 uppercase">课程列表 (已选 3)</div>
            <div class="p-2 rounded-lg bg-sjtu-blue text-white font-medium flex justify-between">
              <span>高级算法设计与分析</span>
              <span>›</span>
            </div>
            <div class="p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300">软件工程与系统架构</div>
            <div class="p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300">操作系统与分布式系统</div>
          </div>
          <div class="p-2 space-y-1 overflow-y-auto bg-slate-50/50 dark:bg-slate-900/50">
            <div class="px-2 py-1 text-[10px] font-bold text-slate-400 uppercase">分类目录 (下钻章节)</div>
            <div class="p-2 rounded-lg bg-slate-200 dark:bg-slate-800 font-medium flex justify-between">
              <span>📁 课堂讲义与课件资料 (38)</span>
              <span>›</span>
            </div>
            <div class="p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300">🎬 课堂双路超清录播 (16)</div>
            <div class="p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300">📝 课程作业与测验附件 (2)</div>
          </div>
          <div class="p-2 space-y-1 overflow-y-auto">
            <div class="px-2 py-1 text-[10px] font-bold text-slate-400 uppercase">文件列表 (已勾选全部)</div>
            <div class="p-1.5 rounded flex items-center justify-between text-[11px] bg-blue-50/60 dark:bg-blue-950/30">
              <span class="truncate">📄 第01讲_动态规划状态压缩.pdf</span>
              <span class="text-slate-400 font-mono">14.2 MB</span>
            </div>
            <div class="p-1.5 rounded flex items-center justify-between text-[11px] bg-blue-50/60 dark:bg-blue-950/30">
              <span class="truncate">📄 第02讲_网络流与二分图匹配.pdf</span>
              <span class="text-slate-400 font-mono">18.6 MB</span>
            </div>
            <div class="p-1.5 rounded flex items-center justify-between text-[11px] bg-blue-50/60 dark:bg-blue-950/30">
              <span class="truncate">📄 第03讲_近似算法与NP完全性.pdf</span>
              <span class="text-slate-400 font-mono">22.1 MB</span>
            </div>
          </div>
        </div>
      </div>

      <!-- PANE 2: 旁听课程 (已纠偏官方时间轴乱序) -->
