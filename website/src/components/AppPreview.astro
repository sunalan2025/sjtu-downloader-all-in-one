---
const screens=[
 {id:'files',label:'课程文件',file:'files.png',title:'沿着课程目录，找到需要的资料',description:'文件夹、分类、搜索与视图切换，使用的都是桌面客户端实际界面。'},
 {id:'courses',label:'学期课程',file:'courses.png',title:'按学期整理你的课程',description:'Canvas 课程按学期浏览，支持网格、列表与分栏。'},
 {id:'schedule',label:'课表日程',file:'schedule.png',title:'把课程、考试和作业放在一张课表里',description:'课程时间、考试安排与作业提交和评分状态，在学校提供数据时一并显示。'},
 {id:'cloud',label:'交大云盘',file:'cloud-drive.png',title:'资料下载之外，也能整理云端文件',description:'浏览目录，搜索和选择文件，按需上传、下载或整理。'},
 {id:'dark',label:'深色界面',file:'dark-mode.png',title:'熟悉的布局，也有深色模式',description:'应用支持浅色、深色和跟随系统，操作布局保持一致。'}
];
---
<section id="preview" class="container section preview-section" aria-labelledby="preview-title">
 <div class="section-heading"><div><p class="eyebrow">先看界面，再决定下载</p><h2 id="preview-title">这就是打开应用后的样子。</h2></div><p>由桌面应用实际组件渲染，使用示例数据。<br/>不包含真实账号、课程或学生信息。</p></div>
 <div class="gallery"><div class="gallery-tabs" role="tablist" aria-label="桌面应用截图">{screens.map((screen,index)=><button id={'tab-'+screen.id} type="button" role="tab" data-screen={screen.id} aria-selected={index===0?'true':'false'} aria-controls={'panel-'+screen.id} tabindex={index===0?0:-1}>{screen.label}</button>)}</div>
 {screens.map((screen,index)=><figure id={'panel-'+screen.id} role="tabpanel" aria-labelledby={'tab-'+screen.id} hidden={index!==0} tabindex="0">
   <div class="screenshot-frame"><img src={'/screenshots/desktop/'+screen.file} alt={screen.title} width="1440" height="960" loading={index===0?'eager':'lazy'} decoding="async"/></div>
   <figcaption><div><strong>{screen.title}</strong><p>{screen.description}</p></div><a data-view-image href={'/screenshots/desktop/'+screen.file} target="_blank" rel="noopener">查看大图 ↗</a></figcaption>
 </figure>)}
 </div>
 <dialog class="image-dialog" aria-label="应用截图大图"><form method="dialog"><button aria-label="关闭大图" autofocus>关闭 ×</button></form><img alt=""/></dialog>
</section>
<script>
 const tabs=[...document.querySelectorAll<HTMLButtonElement>('[data-screen]')];
 function select(id:string){tabs.forEach(tab=>{const active=tab.dataset.screen===id;tab.setAttribute('aria-selected',String(active));tab.tabIndex=active?0:-1;document.getElementById('panel-'+tab.dataset.screen)!.hidden=!active;});}
 tabs.forEach((tab,index)=>{tab.addEventListener('click',()=>select(tab.dataset.screen!));tab.addEventListener('keydown',event=>{let next=index;if(event.key==='ArrowRight')next=(index+1)%tabs.length;else if(event.key==='ArrowLeft')next=(index-1+tabs.length)%tabs.length;else if(event.key==='Home')next=0;else if(event.key==='End')next=tabs.length-1;else return;event.preventDefault();select(tabs[next].dataset.screen!);tabs[next].focus();});});
 const dialog=document.querySelector<HTMLDialogElement>('.image-dialog')!;
 document.querySelectorAll<HTMLAnchorElement>('[data-view-image]').forEach(link=>link.addEventListener('click',event=>{if(!dialog.showModal)return;event.preventDefault();const image=dialog.querySelector('img')!;image.src=link.href;image.alt=link.closest('figure')?.querySelector('img')?.alt||'应用截图';dialog.showModal();}));
 dialog.addEventListener('click',event=>{if(event.target===dialog)dialog.close()});
</script>
