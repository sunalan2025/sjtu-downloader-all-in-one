---
import Icons from './icons/Icons.astro';

export interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

const mockCourses = [
  {
    code: 'CSE5001',
    name: '高级算法设计与分析',
    dept: '计算机科学与工程系',
    slides: 38,
    videos: 16,
    assignments: 2,
    size: '1.42 GB',
    selected: true
  },
  {
    code: 'SE3353',
    name: '软件工程与系统架构',
    dept: '软件学院',
    slides: 45,
    videos: 18,
    assignments: 1,
    size: '1.18 GB',
    selected: true
  },
  {
    code: 'CS3502',
    name: '操作系统原理与实验',
    dept: '计算机科学与工程系',
    slides: 62,
    videos: 24,
    assignments: 0,
    size: '1.24 GB',
    selected: true
  },
  {
    code: 'MATH1205',
    name: '高等代数与解析几何',
    dept: '数学科学学院',
    slides: 28,
    videos: 12,
    assignments: 1,
    size: '680 MB',
    selected: false
  }
];
---

<div class={`relative w-full max-w-6xl mx-auto px-2 sm:px-4 ${className}`} id="app-preview-container">
  <!-- Glowing Ambient Aura (Backlight Layer) -->
  <div
    class="absolute -inset-1 sm:-inset-2 bg-gradient-to-r from-sjtu-navy/30 via-sjtu-blue/20 to-sjtu-cyan/20 rounded-3xl blur-2xl sm:blur-3xl opacity-60 dark:opacity-40 -z-10 pointer-events-none transition-opacity duration-500"
    aria-hidden="true"
  ></div>

  <!-- Perspective Window Container -->
  <div
    class="relative rounded-2xl sm:rounded-3xl border border-slate-200/90 dark:border-slate-700/80 bg-white/95 dark:bg-[#070B14]/95 backdrop-blur-2xl shadow-2xl shadow-sjtu-navy/15 dark:shadow-black/70 overflow-hidden text-slate-800 dark:text-slate-100 transition-all duration-300"
  >
    <!-- ① macOS 真实 TitleBar 1:1 复刻 (精简版：仅保留标签页与视图切换器) -->
    <header
      class="h-14 px-3 sm:px-4 bg-slate-100/90 dark:bg-slate-900/90 border-b border-slate-200/80 dark:border-slate-800/80 flex items-center justify-between select-none gap-2 sm:gap-4 overflow-x-auto no-scrollbar"
    >
      <!-- Traffic Light Buttons -->
      <div class="flex items-center gap-2 shrink-0">
        <span class="w-3 h-3 rounded-full bg-[#FF5F56] border border-[#E0443E]/50 shadow-inner"></span>
        <span class="w-3 h-3 rounded-full bg-[#FFBD2E] border border-[#DEA123]/50 shadow-inner"></span>
        <span class="w-3 h-3 rounded-full bg-[#27C93F] border border-[#1AAB29]/50 shadow-inner"></span>
      </div>

      <!-- Segmented Control: 客户端四大核心主栏目 -->
      <nav class="flex items-center p-1 rounded-xl bg-slate-200/70 dark:bg-slate-800/80 border border-slate-300/50 dark:border-slate-700/60 shadow-inner shrink-0" role="tablist" aria-label="客户端四大核心栏目">
        <button
          type="button"
          role="tab"
          id="tab-btn-canvas"
          data-target="pane-canvas"
          aria-selected="true"
          class="sim-tab-btn px-3 py-1.5 rounded-lg text-xs font-bold transition-all shadow-sm bg-white dark:bg-slate-700 text-sjtu-blue dark:text-blue-400 flex items-center gap-1.5 cursor-pointer"
        >
          <Icons name="book-open" class="w-3.5 h-3.5" />
          <span>Canvas 课程</span>
        </button>
        <button
          type="button"
          role="tab"
          id="tab-btn-audited"
          data-target="pane-audited"
          aria-selected="false"
          class="sim-tab-btn px-3 py-1.5 rounded-lg text-xs font-medium text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 transition-all flex items-center gap-1.5 cursor-pointer"
        >
          <Icons name="video" class="w-3.5 h-3.5" />
          <span>旁听课程</span>
        </button>
        <button
          type="button"
          role="tab"
          id="tab-btn-cnmooc"
          data-target="pane-cnmooc"
          aria-selected="false"
          class="sim-tab-btn px-3 py-1.5 rounded-lg text-xs font-medium text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 transition-all flex items-center gap-1.5 cursor-pointer"
        >
          <Icons name="graduation-cap" class="w-3.5 h-3.5" />
          <span>好大学在线</span>
        </button>
        <button
          type="button"
          role="tab"
          id="tab-btn-schedule"
          data-target="pane-schedule"
          aria-selected="false"
          class="sim-tab-btn px-3 py-1.5 rounded-lg text-xs font-medium text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 transition-all flex items-center gap-1.5 cursor-pointer"
        >
          <span class="text-xs">📅</span>
          <span>课表与日程</span>
        </button>
      </nav>

      <!-- View Switchers on Right (网格 / 列表 / 分栏) -->
      <div class="flex items-center gap-1 p-0.5 rounded-xl bg-slate-200/80 dark:bg-slate-800 border border-slate-300/60 dark:border-slate-700 shrink-0">
        <button
          type="button"
          id="view-btn-grid"
          data-view="grid"
          class="sim-view-btn px-2.5 py-1 rounded-lg font-medium text-xs bg-white dark:bg-slate-700 text-sjtu-blue dark:text-blue-400 shadow-2xs flex items-center gap-1 cursor-pointer"
          title="网格大卡片视图"
        >
          <span>⊞</span>
          <span>网格</span>
        </button>
        <button
          type="button"
          id="view-btn-list"
          data-view="list"
          class="sim-view-btn px-2.5 py-1 rounded-lg font-medium text-xs text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 flex items-center gap-1 cursor-pointer"
          title="详细列表视图"
        >
          <span>☰</span>
          <span>列表</span>
        </button>
        <button
          type="button"
          id="view-btn-column"
          data-view="column"
          class="sim-view-btn px-2.5 py-1 rounded-lg font-medium text-xs text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 flex items-center gap-1 cursor-pointer"
          title="三栏分栏 Miller Columns 视图"
        >
          <span>◫</span>
          <span>分栏</span>
        </button>
      </div>
    </header>

    <!-- ② 真实主工作区 (根据 Tab 动态切换) -->
    <main class="relative min-h-[420px] p-4 sm:p-6 pb-24 overflow-hidden bg-slate-50/40 dark:bg-[#070B14]">
      
      <!-- PANE 1: Canvas 课程 -->
      <div id="pane-canvas" class="sim-pane space-y-4">
        <!-- 网格视图容器 (极简两行结构，去嵌套盒中盒) -->
        <div id="canvas-grid-view" class="sim-canvas-view grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
          {
            mockCourses.map((course) => (
              <div
                class={`rounded-2xl border transition-all p-4 ${
                  course.selected
                    ? 'border-sjtu-blue bg-white dark:bg-slate-900/90 shadow-sm shadow-sjtu-blue/10'
                    : 'border-slate-200 dark:border-slate-800 bg-white/70 dark:bg-slate-900/50 opacity-70 hover:opacity-100'
                }`}
              >
                <div class="flex items-start justify-between gap-2">
                  <div class="flex items-center gap-2">
                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-blue-50 dark:bg-blue-950/60 text-sjtu-blue dark:text-blue-300 font-mono">
                      {course.code}
                    </span>
                    <h4 class="font-bold text-sm text-slate-900 dark:text-slate-100 line-clamp-1">
                      {course.name}
                    </h4>
                  </div>
                  {course.selected ? (
                    <div class="w-5 h-5 rounded-md bg-sjtu-blue text-white flex items-center justify-center text-xs shrink-0">
                      ✓
                    </div>
                  ) : (
                    <div class="w-5 h-5 rounded-md border border-slate-300 dark:border-slate-700 shrink-0" />
                  )}
                </div>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-2 font-medium">
                  {course.slides} 课件 · {course.videos} 视频 · {course.size}
                </p>
              </div>
            ))
          }
        </div>

        <!-- 详细列表视图容器 -->
        <div id="canvas-list-view" class="sim-canvas-view hidden rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 overflow-hidden text-xs">
          <table class="w-full text-left">
            <thead class="bg-slate-50 dark:bg-slate-800/60 text-slate-500 font-semibold border-b border-slate-200 dark:border-slate-800">
              <tr>
                <th class="p-3 w-8"><input type="checkbox" checked readonly class="rounded" /></th>
                <th class="p-3">课程代码与名称</th>
                <th class="p-3">教学开课单位</th>
                <th class="p-3">课件数量</th>
                <th class="p-3">录播状态</th>
                <th class="p-3">预计体积</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
              {
                mockCourses.map((course) => (
                  <tr class={course.selected ? 'bg-blue-50/40 dark:bg-blue-950/20' : ''}>
                    <td class="p-3">
                      <input type="checkbox" checked={course.selected} readonly />
                    </td>
                    <td class="p-3 font-bold text-slate-900 dark:text-slate-100">
                      {course.code} {course.name}
                    </td>
                    <td class="p-3 text-slate-500">{course.dept}</td>
                    <td class="p-3">{course.slides} 份资料</td>
                    <td class="p-3 text-emerald-600 dark:text-emerald-400">{course.videos} 讲超清录播</td>
                    <td class="p-3 font-mono font-medium">{course.size}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <!-- 三栏分栏 (Miller Columns) 视图容器 -->
        <div id="canvas-column-view" class="sim-canvas-view hidden rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 overflow-hidden text-xs h-[280px] grid grid-cols-3 divide-x divide-slate-200 dark:divide-slate-800">
          <div class="p-2 space-y-1 overflow-y-auto">
            <div class="px-2 py-1 text-[10px] font-bold text-slate-400 uppercase">课程列表 (已选 3)</div>
            <div class="p-2 rounded-lg bg-sjtu-blue text-white font-medium flex justify-between">
              <span>高级算法设计与分析</span>
              <span>›</span>
            </div>
            <div class="p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300">软件工程与系统架构</div>
            <div class="p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300">操作系统原理与实验</div>
          </div>
          <div class="p-2 space-y-1 overflow-y-auto bg-slate-50/50 dark:bg-slate-900/50">
            <div class="px-2 py-1 text-[10px] font-bold text-slate-400 uppercase">分类目录 (下钻章节)</div>
            <div class="p-2 rounded-lg bg-slate-200 dark:bg-slate-800 font-medium flex justify-between">
              <span>📁 课堂讲义与课件资料 (38)</span>
              <span>›</span>
            </div>
            <div class="p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300">🎬 课堂双路超清录播 (16)</div>
            <div class="p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300">📝 课程作业与测验附件 (2)</div>
          </div>
          <div class="p-2 space-y-1 overflow-y-auto">
            <div class="px-2 py-1 text-[10px] font-bold text-slate-400 uppercase">文件列表 (已勾选全部)</div>
            <div class="p-1.5 rounded flex items-center justify-between text-[11px] bg-blue-50/60 dark:bg-blue-950/30">
              <span class="truncate">📄 第01讲_动态规划状态压缩.pdf</span>
              <span class="text-slate-400 font-mono">14.2 MB</span>
            </div>
            <div class="p-1.5 rounded flex items-center justify-between text-[11px] bg-blue-50/60 dark:bg-blue-950/30">
              <span class="truncate">📄 第02讲_网络流与二分图匹配.pdf</span>
              <span class="text-slate-400 font-mono">18.6 MB</span>
            </div>
            <div class="p-1.5 rounded flex items-center justify-between text-[11px] bg-blue-50/60 dark:bg-blue-950/30">
              <span class="truncate">📄 第03讲_近似算法与NP完全性.pdf</span>
              <span class="text-slate-400 font-mono">22.1 MB</span>
            </div>
          </div>
        </div>
      </div>

      <!-- PANE 2: 旁听课程 (无小字提示条) -->
      <div id="pane-audited" class="sim-pane hidden space-y-3">
        <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 overflow-hidden divide-y divide-slate-100 dark:divide-slate-800 text-xs">
          <div class="p-3.5 flex items-center justify-between hover:bg-slate-50 dark:hover:bg-slate-800/40">
            <div>
              <div class="font-bold text-slate-900 dark:text-slate-100 text-sm">《量子力学与现代物理前沿》· 第01讲 (2025-09-12)</div>
              <div class="text-slate-500 mt-0.5">主讲：物理与天文学院教学团队 · 教室：上院102</div>
            </div>
            <div class="flex items-center gap-2">
              <span class="px-2 py-1 rounded bg-slate-100 dark:bg-slate-800 font-mono text-[11px]">教师视角 (840 MB)</span>
              <span class="px-2 py-1 rounded bg-blue-50 dark:bg-blue-950/60 text-sjtu-blue dark:text-blue-300 font-mono text-[11px]">PPT视角 (420 MB)</span>
            </div>
          </div>
          <div class="p-3.5 flex items-center justify-between hover:bg-slate-50 dark:hover:bg-slate-800/40">
            <div>
              <div class="font-bold text-slate-900 dark:text-slate-100 text-sm">《量子力学与现代物理前沿》· 第02讲 (2025-09-19)</div>
              <div class="text-slate-500 mt-0.5">主讲：物理与天文学院教学团队 · 教室：上院102</div>
            </div>
            <div class="flex items-center gap-2">
              <span class="px-2 py-1 rounded bg-slate-100 dark:bg-slate-800 font-mono text-[11px]">教师视角 (910 MB)</span>
              <span class="px-2 py-1 rounded bg-blue-50 dark:bg-blue-950/60 text-sjtu-blue dark:text-blue-300 font-mono text-[11px]">PPT视角 (460 MB)</span>
            </div>
          </div>
        </div>
      </div>

      <!-- PANE 3: 好大学在线 (CNMOOC，无小字提示条) -->
      <div id="pane-cnmooc" class="sim-pane hidden space-y-3">
        <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 text-xs">
          <div class="font-bold text-sm text-slate-900 dark:text-slate-100 mb-3 flex items-center gap-2">
            <span>计算机程序设计进阶 (CNMOOC)</span>
            <span class="px-2 py-0.5 rounded text-[10px] bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 font-mono">共 8 单元 · 42 讲</span>
          </div>
          <div class="space-y-2 border-l-2 border-slate-200 dark:border-slate-700 pl-3 ml-2">
            <div class="font-semibold text-slate-800 dark:text-slate-200">第一单元：内存模型与系统指针</div>
            <div class="space-y-1.5 pl-2 text-slate-600 dark:text-slate-400">
              <div class="flex items-center justify-between hover:text-sjtu-blue cursor-pointer">
                <span>1.1 虚拟地址空间与堆栈分配</span>
                <span class="text-slate-400 font-mono text-[11px]">视频 1080P · 185 MB</span>
              </div>
              <div class="flex items-center justify-between hover:text-sjtu-blue cursor-pointer">
                <span>1.2 现代指针语义与引用传递</span>
                <span class="text-slate-400 font-mono text-[11px]">课件 PDF · 8.4 MB</span>
              </div>
            </div>
            <div class="font-semibold text-slate-800 dark:text-slate-200 pt-2">第二单元：高阶函数与模板元编程</div>
            <div class="space-y-1.5 pl-2 text-slate-600 dark:text-slate-400">
              <div class="flex items-center justify-between hover:text-sjtu-blue cursor-pointer">
                <span>2.1 闭包实现原理与 Lambda 表达式</span>
                <span class="text-slate-400 font-mono text-[11px]">视频 1080P · 210 MB</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- PANE 4: 课表与日程管理 (教务排课 + Canvas DDL) -->
      <div id="pane-schedule" class="sim-pane hidden space-y-4">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <!-- 课表网格 -->
          <div class="md:col-span-2 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 text-xs">
            <div class="flex items-center justify-between mb-3">
              <div class="font-bold text-slate-900 dark:text-slate-100 flex items-center gap-2">
                <span>第 7 周课表</span>
                <span class="text-slate-400 font-normal">2025-10-20 ~ 2025-10-26</span>
              </div>
              <div class="flex items-center gap-2">
                <button type="button" class="px-2 py-1 rounded bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-medium hover:bg-slate-200 text-[11px]">
                  导出 ICS 日历
                </button>
              </div>
            </div>
            <div class="grid grid-cols-5 gap-2 text-center">
              <div class="p-2 rounded bg-slate-50 dark:bg-slate-800/40 text-[11px] font-semibold text-slate-600 dark:text-slate-400">周一</div>
              <div class="p-2 rounded bg-slate-50 dark:bg-slate-800/40 text-[11px] font-semibold text-slate-600 dark:text-slate-400">周二</div>
              <div class="p-2 rounded bg-slate-50 dark:bg-slate-800/40 text-[11px] font-semibold text-slate-600 dark:text-slate-400">周三</div>
              <div class="p-2 rounded bg-slate-50 dark:bg-slate-800/40 text-[11px] font-semibold text-slate-600 dark:text-slate-400">周四</div>
              <div class="p-2 rounded bg-slate-50 dark:bg-slate-800/40 text-[11px] font-semibold text-slate-600 dark:text-slate-400">周五</div>
              <div class="p-2 rounded-lg bg-blue-100/70 dark:bg-blue-900/40 text-sjtu-blue dark:text-blue-300 text-left border border-blue-200/60 dark:border-blue-800/60">
                <div class="font-bold text-[10px]">1-2 节</div>
                <div class="truncate text-[11px]">高级算法设计与分析</div>
                <div class="text-[9px] text-slate-500">东下院 104</div>
              </div>
              <div class="p-2 rounded-lg border border-dashed border-slate-200 dark:border-slate-800 text-slate-400 text-[10px] flex items-center justify-center">无课</div>
              <div class="p-2 rounded-lg bg-indigo-100/70 dark:bg-indigo-900/40 text-indigo-700 dark:text-indigo-300 text-left border border-indigo-200/60 dark:border-indigo-800/60">
                <div class="font-bold text-[10px]">3-4 节</div>
                <div class="truncate text-[11px]">软件工程与系统架构</div>
                <div class="text-[9px] text-slate-500">中院 315</div>
              </div>
              <div class="p-2 rounded-lg border border-dashed border-slate-200 dark:border-slate-800 text-slate-400 text-[10px] flex items-center justify-center">无课</div>
              <div class="p-2 rounded-lg bg-cyan-100/70 dark:bg-cyan-900/40 text-cyan-800 dark:text-cyan-300 text-left border border-cyan-200/60 dark:border-cyan-800/60">
                <div class="font-bold text-[10px]">7-8 节</div>
                <div class="truncate text-[11px]">操作系统原理与实验</div>
                <div class="text-[9px] text-slate-500">机房 电院3-201</div>
              </div>
            </div>
          </div>

          <!-- Canvas DDL 预警卡片 -->
          <div class="rounded-xl border border-amber-300/80 dark:border-amber-800/70 bg-amber-50/50 dark:bg-amber-950/30 p-4 text-xs flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-2">
                <span class="font-bold text-amber-900 dark:text-amber-200 flex items-center gap-1.5">
                  <span>⚠️</span>
                  <span>Canvas 作业预警</span>
                </span>
                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-200/80 dark:bg-amber-900/60 text-amber-800 dark:text-amber-300">
                  即将截止
                </span>
              </div>
              <h5 class="font-bold text-slate-900 dark:text-slate-100 text-sm mt-1">软件架构实验二：并发调优</h5>
              <p class="text-slate-600 dark:text-slate-400 mt-1">需提交代码与分析报告 PDF</p>
            </div>
            <div class="text-[11px] text-amber-700 dark:text-amber-400 pt-3 border-t border-amber-200 dark:border-amber-900/50">
              ⏳ 10-24 23:59 截止 (倒计时 24 小时)
            </div>
          </div>
        </div>
      </div>

    </main>

    <!-- ③ 底栏标志性 Apple HIG 悬浮指挥动作岛 (极简化：左侧汇总 + 右侧操作) -->
    <div
      role="toolbar"
      aria-label="下载底栏智能指挥动作岛"
      class="absolute bottom-4 left-1/2 -translate-x-1/2 z-30 max-w-[calc(100vw-3rem)] w-fit bg-white/95 dark:bg-[#1C202B]/95 backdrop-blur-xl border border-black/[0.08] dark:border-slate-700/80 shadow-2xl shadow-black/20 dark:shadow-black/60 rounded-2xl p-2.5 flex items-center gap-3 sm:gap-4 select-none overflow-x-auto no-scrollbar"
    >
      <!-- 左侧信息汇聚 -->
      <div class="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-slate-100/90 dark:bg-slate-800/90 text-xs text-slate-800 dark:text-slate-200 whitespace-nowrap shrink-0">
        <span class="w-2 h-2 rounded-full bg-sjtu-blue animate-pulse"></span>
        <span class="font-bold">✦ 已选 3 门课程 (3.84 GB)</span>
      </div>

      <!-- 分割线 -->
      <div class="h-4 w-px bg-slate-200 dark:bg-slate-700 shrink-0"></div>

      <!-- 存储目标模式选择器 -->
      <div class="hidden sm:flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl bg-slate-100/80 dark:bg-slate-800/80 text-xs font-medium text-slate-700 dark:text-slate-300 shrink-0">
        <Icons name="cloud" class="w-3.5 h-3.5 text-sjtu-blue" />
        <span>本地与云盘双备份</span>
        <Icons name="chevron-down" class="w-3 h-3 text-slate-400" />
      </div>

      <!-- 立即下载行动 CTA 主按钮 -->
      <button
        type="button"
        class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-xl text-xs font-bold bg-gradient-to-r from-sjtu-navy to-sjtu-blue text-white shadow-md shadow-sjtu-blue/30 hover:shadow-lg hover:shadow-sjtu-blue/40 active:scale-95 transition-all cursor-pointer shrink-0"
      >
        <span>开始同步 ›</span>
      </button>
    </div>
  </div>
</div>

<script>
  function setupInteractiveSimulator() {
    const tabBtns = document.querySelectorAll<HTMLButtonElement>('.sim-tab-btn');
    const panes = document.querySelectorAll<HTMLElement>('.sim-pane');

    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');
        if (!targetId) return;

        tabBtns.forEach((b) => {
          b.setAttribute('aria-selected', 'false');
          b.className = 'sim-tab-btn px-3 py-1.5 rounded-lg text-xs font-medium text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 transition-all flex items-center gap-1.5 cursor-pointer';
        });

        btn.setAttribute('aria-selected', 'true');
        btn.className = 'sim-tab-btn px-3 py-1.5 rounded-lg text-xs font-bold transition-all shadow-sm bg-white dark:bg-slate-700 text-sjtu-blue dark:text-blue-400 flex items-center gap-1.5 cursor-pointer';

        panes.forEach((p) => {
          if (p.id === targetId) {
            p.classList.remove('hidden');
          } else {
            p.classList.add('hidden');
          }
        });
      });
    });

    // 视图切换交互 (网格 / 列表 / 分栏)
    const viewBtns = document.querySelectorAll<HTMLButtonElement>('.sim-view-btn');
    const canvasViews = document.querySelectorAll<HTMLElement>('.sim-canvas-view');

    viewBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const view = btn.getAttribute('data-view');
        if (!view) return;

        viewBtns.forEach((b) => {
          b.className = 'sim-view-btn px-2.5 py-1 rounded-lg font-medium text-xs text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 flex items-center gap-1 cursor-pointer';
        });
        btn.className = 'sim-view-btn px-2.5 py-1 rounded-lg font-medium text-xs bg-white dark:bg-slate-700 text-sjtu-blue dark:text-blue-400 shadow-2xs flex items-center gap-1 cursor-pointer';

        canvasViews.forEach((cv) => {
          if (cv.id === `canvas-${view}-view`) {
            cv.classList.remove('hidden');
          } else {
            cv.classList.add('hidden');
          }
        });
      });
    });
  }

  // 页面加载或 Astro 页面切换时执行绑定
  setupInteractiveSimulator();
  document.addEventListener('astro:page-load', setupInteractiveSimulator);
</script>
