---
import Icons from './icons/Icons.astro';

export interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

const mockCourses = [
  {
    code: 'CSE5001',
    name: '高级算法设计与分析',
    dept: '计算机科学与工程系',
    slides: 38,
    videos: 16,
    assignments: 2,
    size: '1.42 GB',
    selected: true
  },
  {
    code: 'SE3353',
    name: '软件工程与系统架构',
    dept: '软件学院',
    slides: 45,
    videos: 18,
    assignments: 1,
    size: '1.18 GB',
    selected: true
  },
  {
    code: 'CS3502',
    name: '操作系统原理与实验',
    dept: '计算机科学与工程系',
    slides: 62,
    videos: 24,
    assignments: 0,
    size: '1.24 GB',
    selected: true
  },
  {
    code: 'MATH1205',
    name: '高等代数与解析几何',
    dept: '数学科学学院',
    slides: 28,
    videos: 12,
    assignments: 1,
    size: '680 MB',
    selected: false
  }
];
---

<div class={`relative w-full max-w-6xl mx-auto px-2 sm:px-4 ${className}`} id="app-preview-container">
  <!-- Glowing Ambient Aura (Backlight Layer) -->
  <div
    class="absolute -inset-1 sm:-inset-2 bg-gradient-to-r from-sjtu-navy/30 via-sjtu-blue/20 to-sjtu-cyan/20 rounded-3xl blur-2xl sm:blur-3xl opacity-60 dark:opacity-40 -z-10 pointer-events-none transition-opacity duration-500"
    aria-hidden="true"
  ></div>

  <!-- Perspective Window Container (带滚动视差回正) -->
  <div
    id="simulator-window"
    style="transform: perspective(1200px) rotateX(4deg); transition: transform 0.35s ease-out; will-change: transform;"
    class="relative rounded-2xl sm:rounded-3xl border border-slate-200/90 dark:border-slate-700/80 bg-white/95 dark:bg-[#070B14]/95 backdrop-blur-2xl shadow-2xl shadow-sjtu-navy/15 dark:shadow-black/70 overflow-hidden text-slate-800 dark:text-slate-100 transition-all duration-300"
  >
    <!-- ① macOS 真实 TitleBar 1:1 复刻 (精简版：仅保留标签页与视图切换器) -->
    <header
      class="h-14 px-3 sm:px-4 bg-slate-100/90 dark:bg-slate-900/90 border-b border-slate-200/80 dark:border-slate-800/80 flex items-center justify-between select-none gap-2 sm:gap-4 overflow-x-auto no-scrollbar"
    >
      <!-- Traffic Light Buttons -->
      <div class="flex items-center gap-2 shrink-0">
        <span class="w-3 h-3 rounded-full bg-[#FF5F56] border border-[#E0443E]/50 shadow-inner"></span>
        <span class="w-3 h-3 rounded-full bg-[#FFBD2E] border border-[#DEA123]/50 shadow-inner"></span>
        <span class="w-3 h-3 rounded-full bg-[#27C93F] border border-[#1AAB29]/50 shadow-inner"></span>
      </div>

      <!-- Segmented Control: 客户端四大核心主栏目 -->
      <nav class="flex items-center p-1 rounded-xl bg-slate-200/70 dark:bg-slate-800/80 border border-slate-300/50 dark:border-slate-700/60 shadow-inner shrink-0" role="tablist" aria-label="客户端四大核心栏目">
        <button
          type="button"
          role="tab"
          id="tab-btn-canvas"
          data-target="pane-canvas"
          aria-selected="true"
          class="sim-tab-btn px-3 py-1.5 rounded-lg text-xs font-bold transition-all shadow-sm bg-white dark:bg-slate-700 text-sjtu-blue dark:text-blue-400 flex items-center gap-1.5 cursor-pointer"
        >
          <Icons name="book-open" class="w-3.5 h-3.5" />
          <span>Canvas 课程</span>
        </button>
        <button
          type="button"
          role="tab"
          id="tab-btn-audited"
          data-target="pane-audited"
          aria-selected="false"
          class="sim-tab-btn px-3 py-1.5 rounded-lg text-xs font-medium text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 transition-all flex items-center gap-1.5 cursor-pointer"
        >
          <Icons name="video" class="w-3.5 h-3.5" />
          <span>旁听课程</span>
        </button>
        <button
          type="button"
          role="tab"
          id="tab-btn-cnmooc"
          data-target="pane-cnmooc"
          aria-selected="false"
          class="sim-tab-btn px-3 py-1.5 rounded-lg text-xs font-medium text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 transition-all flex items-center gap-1.5 cursor-pointer"
        >
          <Icons name="graduation-cap" class="w-3.5 h-3.5" />
          <span>好大学在线</span>
        </button>
        <button
          type="button"
          role="tab"
          id="tab-btn-schedule"
          data-target="pane-schedule"
          aria-selected="false"
          class="sim-tab-btn px-3 py-1.5 rounded-lg text-xs font-medium text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 transition-all flex items-center gap-1.5 cursor-pointer"
        >
          <span class="text-xs">📅</span>
          <span>课表与日程</span>
        </button>
      </nav>

      <!-- View Switchers on Right (网格 / 列表 / 分栏) -->
      <div class="flex items-center gap-1 p-0.5 rounded-xl bg-slate-200/80 dark:bg-slate-800 border border-slate-300/60 dark:border-slate-700 shrink-0">
        <button
          type="button"
          id="view-btn-grid"
          data-view="grid"
          class="sim-view-btn px-2.5 py-1 rounded-lg font-medium text-xs bg-white dark:bg-slate-700 text-sjtu-blue dark:text-blue-400 shadow-2xs flex items-center gap-1 cursor-pointer"
          title="网格大卡片视图"
        >
          <span>⊞</span>
          <span>网格</span>
        </button>
        <button
          type="button"
          id="view-btn-list"
          data-view="list"
          class="sim-view-btn px-2.5 py-1 rounded-lg font-medium text-xs text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 flex items-center gap-1 cursor-pointer"
          title="详细列表视图"
        >
          <span>☰</span>
          <span>列表</span>
        </button>
        <button
          type="button"
          id="view-btn-column"
          data-view="column"
          class="sim-view-btn px-2.5 py-1 rounded-lg font-medium text-xs text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 flex items-center gap-1 cursor-pointer"
          title="三栏分栏 Miller Columns 视图"
        >
          <span>◫</span>
          <span>分栏</span>
        </button>
      </div>
    </header>

    <!-- ② 真实主工作区 (根据 Tab 动态切换) -->
    <main class="relative min-h-[420px] p-4 sm:p-6 pb-24 overflow-hidden bg-slate-50/40 dark:bg-[#070B14]">
      
      <!-- PANE 1: Canvas 课程 -->
      <div id="pane-canvas" class="sim-pane space-y-4">
        <!-- 网格视图容器 (极简两行结构，去嵌套盒中盒，支持跨视图双向响应) -->
        <div id="canvas-grid-view" class="sim-canvas-view grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
          {
            mockCourses.map((course) => (
              <div
                class={`sim-grid-card rounded-2xl border transition-all p-4 cursor-pointer select-none ${
                  course.selected
                    ? 'border-sjtu-blue bg-white dark:bg-slate-900/90 shadow-sm shadow-sjtu-blue/10'
                    : 'border-slate-200 dark:border-slate-800 bg-white/70 dark:bg-slate-900/50 opacity-70 hover:opacity-100'
                }`}
                data-course-id={course.code}
              >
                <div class="flex items-start justify-between gap-2">
                  <div class="flex items-center gap-2">
                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-blue-50 dark:bg-blue-950/60 text-sjtu-blue dark:text-blue-300 font-mono">
                      {course.code}
                    </span>
                    <h4 class="font-bold text-sm text-slate-900 dark:text-slate-100 line-clamp-1">
                      {course.name}
                    </h4>
                  </div>
                  <div class={`sim-grid-checkbox w-5 h-5 rounded-md flex items-center justify-center text-xs shrink-0 transition-colors ${
                    course.selected
                      ? 'bg-sjtu-blue text-white'
                      : 'border border-slate-300 dark:border-slate-700'
                  }`}>
                    {course.selected ? '✓' : ''}
                  </div>
                </div>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-2 font-medium">
                  {course.slides} 课件 · {course.videos} 视频 · {course.size}
                </p>
              </div>
            ))
          }
        </div>

        <!-- 详细列表视图容器 -->
        <div id="canvas-list-view" class="sim-canvas-view hidden rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 overflow-hidden text-xs">
          <table class="w-full text-left">
            <thead class="bg-slate-50 dark:bg-slate-800/60 text-slate-500 font-semibold border-b border-slate-200 dark:border-slate-800">
              <tr>
                <th class="p-3 w-8">
                  <span class="sr-only">选择</span>
                </th>
                <th class="p-3">课程代码与名称</th>
                <th class="p-3">教学开课单位</th>
                <th class="p-3">课件数量</th>
                <th class="p-3">录播状态</th>
                <th class="p-3">预计体积</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
              {
                mockCourses.map((course) => (
                  <tr
                    class={`sim-list-row cursor-pointer transition-colors ${course.selected ? 'bg-blue-50/40 dark:bg-blue-950/20' : 'hover:bg-slate-50/50 dark:hover:bg-slate-800/30'}`}
                    data-course-id={course.code}
                  >
                    <td class="p-3">
                      <input
                        type="checkbox"
                        checked={course.selected}
                        class="sim-list-checkbox rounded text-sjtu-blue focus:ring-sjtu-blue cursor-pointer"
                        data-course-id={course.code}
                      />
                    </td>
                    <td class="p-3 font-bold text-slate-900 dark:text-slate-100">
                      {course.code} {course.name}
                    </td>
                    <td class="p-3 text-slate-500">{course.dept}</td>
                    <td class="p-3">{course.slides} 份资料</td>
                    <td class="p-3 text-emerald-600 dark:text-emerald-400">{course.videos} 讲超清录播</td>
                    <td class="p-3 font-mono font-medium">{course.size}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <!-- 三栏分栏 (Miller Columns) 视图容器 (支持下钻与分类双维度联动) -->
        <div id="canvas-column-view" class="sim-canvas-view hidden rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 overflow-hidden text-xs h-[280px] grid grid-cols-3 divide-x divide-slate-200 dark:divide-slate-800">
          <div class="p-2 space-y-1 overflow-y-auto" id="col-courses">
            <div class="px-2 py-1 text-[10px] font-bold text-slate-400 uppercase" id="col-courses-header">课程列表 (已选 3)</div>
            <button
              type="button"
              class="col-course-item w-full text-left p-2 rounded-lg bg-sjtu-blue text-white font-medium flex justify-between items-center cursor-pointer text-xs transition-colors"
              data-course="CSE5001"
            >
              <span>高级算法设计与分析</span>
              <span>›</span>
            </button>
            <button
              type="button"
              class="col-course-item w-full text-left p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 font-medium flex justify-between items-center cursor-pointer text-xs transition-colors"
              data-course="SE3353"
            >
              <span>软件工程与系统架构</span>
              <span>›</span>
            </button>
            <button
              type="button"
              class="col-course-item w-full text-left p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 font-medium flex justify-between items-center cursor-pointer text-xs transition-colors"
              data-course="CS3502"
            >
              <span>操作系统原理与实验</span>
              <span>›</span>
            </button>
            <button
              type="button"
              class="col-course-item w-full text-left p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 font-medium flex justify-between items-center cursor-pointer text-xs transition-colors"
              data-course="MATH1205"
            >
              <span>高等代数与解析几何</span>
              <span>›</span>
            </button>
          </div>
          <div class="p-2 space-y-1 overflow-y-auto bg-slate-50/50 dark:bg-slate-900/50" id="col-categories">
            <div class="px-2 py-1 text-[10px] font-bold text-slate-400 uppercase">分类目录 (下钻章节)</div>
            <button
              type="button"
              id="col-cat-slides-btn"
              data-category="slides"
              class="col-cat-btn w-full text-left p-2 rounded-lg bg-slate-200 dark:bg-slate-800 font-medium flex justify-between items-center text-xs cursor-pointer transition-colors"
            >
              <span id="col-cat-slides-text">📁 课堂讲义与课件资料 (38)</span>
              <span>›</span>
            </button>
            <button
              type="button"
              id="col-cat-videos-btn"
              data-category="videos"
              class="col-cat-btn w-full text-left p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 font-medium flex justify-between items-center text-xs cursor-pointer transition-colors"
            >
              <span id="col-cat-videos-text">🎬 课堂双路超清录播 (16)</span>
              <span>›</span>
            </button>
          </div>
          <div class="p-2 space-y-1 overflow-y-auto" id="col-files">
            <div class="px-2 py-1 text-[10px] font-bold text-slate-400 uppercase" id="col-files-header">文件列表 (已勾选全部课件)</div>
            <div id="col-file-list" class="space-y-1">
              <div class="p-1.5 rounded flex items-center justify-between text-[11px] bg-blue-50/60 dark:bg-blue-950/30">
                <span class="truncate">📄 第01讲_动态规划状态压缩.pdf</span>
                <span class="text-slate-400 font-mono">14.2 MB</span>
              </div>
              <div class="p-1.5 rounded flex items-center justify-between text-[11px] bg-blue-50/60 dark:bg-blue-950/30">
                <span class="truncate">📄 第02讲_网络流与二分图匹配.pdf</span>
                <span class="text-slate-400 font-mono">18.6 MB</span>
              </div>
              <div class="p-1.5 rounded flex items-center justify-between text-[11px] bg-blue-50/60 dark:bg-blue-950/30">
                <span class="truncate">📄 第03讲_近似算法与NP完全性.pdf</span>
                <span class="text-slate-400 font-mono">22.1 MB</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- PANE 2: 旁听课程 (无小字提示条) -->
      <div id="pane-audited" class="sim-pane hidden space-y-3">
        <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 overflow-hidden divide-y divide-slate-100 dark:divide-slate-800 text-xs">
          <div class="p-3.5 flex items-center justify-between hover:bg-slate-50 dark:hover:bg-slate-800/40">
            <div>
              <div class="font-bold text-slate-900 dark:text-slate-100 text-sm">《量子力学与现代物理前沿》· 第01讲 (2025-09-12)</div>
              <div class="text-slate-500 mt-0.5">主讲：物理与天文学院教学团队 · 教室：上院102</div>
            </div>
            <div class="flex items-center gap-2">
              <span class="px-2 py-1 rounded bg-slate-100 dark:bg-slate-800 font-mono text-[11px]">教师视角 (840 MB)</span>
              <span class="px-2 py-1 rounded bg-blue-50 dark:bg-blue-950/60 text-sjtu-blue dark:text-blue-300 font-mono text-[11px]">PPT视角 (420 MB)</span>
            </div>
          </div>
          <div class="p-3.5 flex items-center justify-between hover:bg-slate-50 dark:hover:bg-slate-800/40">
            <div>
              <div class="font-bold text-slate-900 dark:text-slate-100 text-sm">《量子力学与现代物理前沿》· 第02讲 (2025-09-19)</div>
              <div class="text-slate-500 mt-0.5">主讲：物理与天文学院教学团队 · 教室：上院102</div>
            </div>
            <div class="flex items-center gap-2">
              <span class="px-2 py-1 rounded bg-slate-100 dark:bg-slate-800 font-mono text-[11px]">教师视角 (910 MB)</span>
              <span class="px-2 py-1 rounded bg-blue-50 dark:bg-blue-950/60 text-sjtu-blue dark:text-blue-300 font-mono text-[11px]">PPT视角 (460 MB)</span>
            </div>
          </div>
        </div>
      </div>

      <!-- PANE 3: 好大学在线 (CNMOOC，无小字提示条) -->
      <div id="pane-cnmooc" class="sim-pane hidden space-y-3">
        <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 text-xs">
          <div class="font-bold text-sm text-slate-900 dark:text-slate-100 mb-3 flex items-center gap-2">
            <span>计算机程序设计进阶 (CNMOOC)</span>
            <span class="px-2 py-0.5 rounded text-[10px] bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 font-mono">共 8 单元 · 42 讲</span>
          </div>
          <div class="space-y-2 border-l-2 border-slate-200 dark:border-slate-700 pl-3 ml-2">
            <div class="font-semibold text-slate-800 dark:text-slate-200">第一单元：内存模型与系统指针</div>
            <div class="space-y-1.5 pl-2 text-slate-600 dark:text-slate-400">
              <div class="flex items-center justify-between hover:text-sjtu-blue cursor-pointer">
                <span>1.1 虚拟地址空间与堆栈分配</span>
                <span class="text-slate-400 font-mono text-[11px]">视频 1080P · 185 MB</span>
              </div>
              <div class="flex items-center justify-between hover:text-sjtu-blue cursor-pointer">
                <span>1.2 现代指针语义与引用传递</span>
                <span class="text-slate-400 font-mono text-[11px]">课件 PDF · 8.4 MB</span>
              </div>
            </div>
            <div class="font-semibold text-slate-800 dark:text-slate-200 pt-2">第二单元：高阶函数与模板元编程</div>
            <div class="space-y-1.5 pl-2 text-slate-600 dark:text-slate-400">
              <div class="flex items-center justify-between hover:text-sjtu-blue cursor-pointer">
                <span>2.1 闭包实现原理与 Lambda 表达式</span>
                <span class="text-slate-400 font-mono text-[11px]">视频 1080P · 210 MB</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- PANE 4: 课表与日程管理 (教务排课 + Canvas DDL) -->
      <div id="pane-schedule" class="sim-pane hidden space-y-4">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <!-- 课表网格 -->
          <div class="md:col-span-2 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 text-xs">
            <div class="flex items-center justify-between mb-3">
              <div class="font-bold text-slate-900 dark:text-slate-100 flex items-center gap-2">
                <span>第 7 周课表</span>
                <span class="text-slate-400 font-normal">2025-10-20 ~ 2025-10-26</span>
              </div>
              <div class="flex items-center gap-2">
                <button type="button" class="px-2 py-1 rounded bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-medium hover:bg-slate-200 text-[11px]">
                  导出 ICS 日历
                </button>
              </div>
            </div>
            <div class="grid grid-cols-5 gap-2 text-center">
              <div class="p-2 rounded bg-slate-50 dark:bg-slate-800/40 text-[11px] font-semibold text-slate-600 dark:text-slate-400">周一</div>
              <div class="p-2 rounded bg-slate-50 dark:bg-slate-800/40 text-[11px] font-semibold text-slate-600 dark:text-slate-400">周二</div>
              <div class="p-2 rounded bg-slate-50 dark:bg-slate-800/40 text-[11px] font-semibold text-slate-600 dark:text-slate-400">周三</div>
              <div class="p-2 rounded bg-slate-50 dark:bg-slate-800/40 text-[11px] font-semibold text-slate-600 dark:text-slate-400">周四</div>
              <div class="p-2 rounded bg-slate-50 dark:bg-slate-800/40 text-[11px] font-semibold text-slate-600 dark:text-slate-400">周五</div>
              <div class="p-2 rounded-lg bg-blue-100/70 dark:bg-blue-900/40 text-sjtu-blue dark:text-blue-300 text-left border border-blue-200/60 dark:border-blue-800/60">
                <div class="font-bold text-[10px]">1-2 节</div>
                <div class="truncate text-[11px]">高级算法设计与分析</div>
                <div class="text-[9px] text-slate-500">东下院 104</div>
              </div>
              <div class="p-2 rounded-lg border border-dashed border-slate-200 dark:border-slate-800 text-slate-400 text-[10px] flex items-center justify-center">无课</div>
              <div class="p-2 rounded-lg bg-indigo-100/70 dark:bg-indigo-900/40 text-indigo-700 dark:text-indigo-300 text-left border border-indigo-200/60 dark:border-indigo-800/60">
                <div class="font-bold text-[10px]">3-4 节</div>
                <div class="truncate text-[11px]">软件工程与系统架构</div>
                <div class="text-[9px] text-slate-500">中院 315</div>
              </div>
              <div class="p-2 rounded-lg border border-dashed border-slate-200 dark:border-slate-800 text-slate-400 text-[10px] flex items-center justify-center">无课</div>
              <div class="p-2 rounded-lg bg-cyan-100/70 dark:bg-cyan-900/40 text-cyan-800 dark:text-cyan-300 text-left border border-cyan-200/60 dark:border-cyan-800/60">
                <div class="font-bold text-[10px]">7-8 节</div>
                <div class="truncate text-[11px]">操作系统原理与实验</div>
                <div class="text-[9px] text-slate-500">机房 电院3-201</div>
              </div>
            </div>
          </div>

          <!-- Canvas DDL 预警卡片 -->
          <div class="rounded-xl border border-amber-300/80 dark:border-amber-800/70 bg-amber-50/50 dark:bg-amber-950/30 p-4 text-xs flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-2">
                <span class="font-bold text-amber-900 dark:text-amber-200 flex items-center gap-1.5">
                  <span>⚠️</span>
                  <span>Canvas 作业预警</span>
                </span>
                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-200/80 dark:bg-amber-900/60 text-amber-800 dark:text-amber-300">
                  即将截止
                </span>
              </div>
              <h5 class="font-bold text-slate-900 dark:text-slate-100 text-sm mt-1">软件架构实验二：并发调优</h5>
              <p class="text-slate-600 dark:text-slate-400 mt-1">需提交代码与分析报告 PDF</p>
            </div>
            <div class="text-[11px] text-amber-700 dark:text-amber-400 pt-3 border-t border-amber-200 dark:border-amber-900/50">
              ⏳ 10-24 23:59 截止 (倒计时 24 小时)
            </div>
          </div>
        </div>
      </div>

    </main>

    <!-- ③ 底栏标志性 Apple HIG 悬浮指挥动作岛 (极简化：左侧汇总 + 右侧操作，支持流光进度条与模拟同步演示) -->
    <div
      role="toolbar"
      aria-label="下载底栏智能指挥动作岛"
      id="floating-command-island"
      class="absolute bottom-4 left-1/2 -translate-x-1/2 z-30 max-w-[calc(100vw-3rem)] w-fit bg-white/95 dark:bg-[#1C202B]/95 backdrop-blur-xl border border-black/[0.08] dark:border-slate-700/80 shadow-2xl shadow-black/20 dark:shadow-black/60 rounded-2xl p-2.5 flex items-center gap-3 sm:gap-4 select-none overflow-x-auto no-scrollbar relative overflow-hidden"
    >
      <!-- 2px 流光激光进度条 -->
      <div
        id="island-laser-progress"
        class="absolute bottom-0 left-0 h-[2.5px] bg-gradient-to-r from-sjtu-blue via-sjtu-cyan to-emerald-400 rounded-b-2xl transition-all duration-300 w-0 opacity-0 pointer-events-none"
      ></div>

      <!-- 左侧信息汇聚 -->
      <div class="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-slate-100/90 dark:bg-slate-800/90 text-xs text-slate-800 dark:text-slate-200 whitespace-nowrap shrink-0">
        <span class="w-2 h-2 rounded-full bg-sjtu-blue animate-pulse"></span>
        <span id="island-summary-text" class="font-bold tabular-nums">✦ 已选 3 门课程 (3.84 GB)</span>
      </div>

      <!-- 分割线 -->
      <div class="h-4 w-px bg-slate-200 dark:bg-slate-700 shrink-0"></div>

      <!-- 存储目标模式选择器 -->
      <div class="hidden sm:flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl bg-slate-100/80 dark:bg-slate-800/80 text-xs font-medium text-slate-700 dark:text-slate-300 shrink-0">
        <Icons name="cloud" class="w-3.5 h-3.5 text-sjtu-blue" />
        <span>本地与云盘双备份</span>
        <Icons name="chevron-down" class="w-3 h-3 text-slate-400" />
      </div>

      <!-- 立即下载行动 CTA 主按钮 -->
      <button
        type="button"
        id="sim-sync-btn"
        class="inline-flex items-center justify-center gap-1.5 px-4 py-1.5 rounded-xl text-xs font-bold bg-gradient-to-r from-sjtu-navy to-sjtu-blue text-white shadow-md shadow-sjtu-blue/30 hover:shadow-lg hover:shadow-sjtu-blue/40 active:scale-95 transition-all cursor-pointer shrink-0 min-w-[104px]"
      >
        <span id="sim-sync-btn-text">开始同步 ›</span>
      </button>
    </div>
  </div>
</div>

<script>
  function setupInteractiveSimulator() {
    // 0. 滚动视差回正 (Scroll Perspective Pitch)
    const simWindow = document.getElementById('simulator-window');
    if (simWindow && !simWindow.dataset.pitchBound) {
      simWindow.dataset.pitchBound = 'true';
      const handleScroll = () => {
        const rect = simWindow.getBoundingClientRect();
        const winH = window.innerHeight;
        // 当视窗向下滚动使得模拟器进入屏幕中心区域时，旋转角度从 4deg 平滑回正至 0deg
        const progress = Math.max(0, Math.min(1, (winH - rect.top) / (winH * 0.75)));
        const deg = (1 - progress) * 4;
        simWindow.style.transform = `perspective(1200px) rotateX(${deg.toFixed(1)}deg)`;
      };
      window.addEventListener('scroll', handleScroll, { passive: true });
      handleScroll();
    }

    // 1. Segmented Tabs 切换交互
    const tabBtns = document.querySelectorAll<HTMLButtonElement>('.sim-tab-btn');
    const panes = document.querySelectorAll<HTMLElement>('.sim-pane');

    tabBtns.forEach((btn) => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = 'true';
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');
        if (!targetId) return;

        tabBtns.forEach((b) => {
          b.setAttribute('aria-selected', 'false');
          b.className = 'sim-tab-btn px-3 py-1.5 rounded-lg text-xs font-medium text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 transition-all flex items-center gap-1.5 cursor-pointer';
        });

        btn.setAttribute('aria-selected', 'true');
        btn.className = 'sim-tab-btn px-3 py-1.5 rounded-lg text-xs font-bold transition-all shadow-sm bg-white dark:bg-slate-700 text-sjtu-blue dark:text-blue-400 flex items-center gap-1.5 cursor-pointer';

        panes.forEach((p) => {
          if (p.id === targetId) {
            p.classList.remove('hidden');
          } else {
            p.classList.add('hidden');
          }
        });
      });
    });

    // 2. 视图切换交互 (网格 / 列表 / 分栏)
    const viewBtns = document.querySelectorAll<HTMLButtonElement>('.sim-view-btn');
    const canvasViews = document.querySelectorAll<HTMLElement>('.sim-canvas-view');

    viewBtns.forEach((btn) => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = 'true';
      btn.addEventListener('click', () => {
        const view = btn.getAttribute('data-view');
        if (!view) return;

        viewBtns.forEach((b) => {
          b.className = 'sim-view-btn px-2.5 py-1 rounded-lg font-medium text-xs text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 flex items-center gap-1 cursor-pointer';
        });
        btn.className = 'sim-view-btn px-2.5 py-1 rounded-lg font-medium text-xs bg-white dark:bg-slate-700 text-sjtu-blue dark:text-blue-400 shadow-2xs flex items-center gap-1 cursor-pointer';

        canvasViews.forEach((cv) => {
          if (cv.id === `canvas-${view}-view`) {
            cv.classList.remove('hidden');
          } else {
            cv.classList.add('hidden');
          }
        });
      });
    });

    // 3. 课程全维度数据源与已选状态机 (网格 + 列表跨视图无缝共享状态)
    const courseMeta: Record<
      string,
      {
        code: string;
        name: string;
        dept: string;
        slides: number;
        videos: number;
        sizeGb: number;
        slidesFiles: Array<{ name: string; size: string }>;
        videoFiles: Array<{ name: string; size: string }>;
      }
    > = {
      CSE5001: {
        code: 'CSE5001',
        name: '高级算法设计与分析',
        dept: '计算机科学与工程系',
        slides: 38,
        videos: 16,
        sizeGb: 1.42,
        slidesFiles: [
          { name: '📄 第01讲_动态规划状态压缩.pdf', size: '14.2 MB' },
          { name: '📄 第02讲_网络流与二分图匹配.pdf', size: '18.6 MB' },
          { name: '📄 第03讲_近似算法与NP完全性.pdf', size: '22.1 MB' }
        ],
        videoFiles: [
          { name: '📹 第01讲_算法复杂度与递推方程_双路超清.mp4', size: '420 MB' },
          { name: '📹 第02讲_网络流与割集建模_双路超清.mp4', size: '480 MB' },
          { name: '📹 第03讲_近似算法与规约技术_双路超清.mp4', size: '510 MB' }
        ]
      },
      SE3353: {
        code: 'SE3353',
        name: '软件工程与系统架构',
        dept: '软件学院',
        slides: 45,
        videos: 18,
        sizeGb: 1.18,
        slidesFiles: [
          { name: '📄 第01讲_微服务架构设计与领域驱动.pdf', size: '16.8 MB' },
          { name: '📄 第02讲_容器编排与DevOps实践.pdf', size: '21.4 MB' },
          { name: '📄 第03讲_高并发系统容灾与高可用.pdf', size: '19.5 MB' }
        ],
        videoFiles: [
          { name: '📹 第01讲_微服务架构设计与实战_双路超清.mp4', size: '390 MB' },
          { name: '📹 第02讲_容器化编排与Kubernetes_双路超清.mp4', size: '440 MB' },
          { name: '📹 第03讲_高可用服务治理与容灾_双路超清.mp4', size: '460 MB' }
        ]
      },
      CS3502: {
        code: 'CS3502',
        name: '操作系统原理与实验',
        dept: '计算机科学与工程系',
        slides: 62,
        videos: 24,
        sizeGb: 1.24,
        slidesFiles: [
          { name: '📄 第01讲_操作系统内核与系统调用.pdf', size: '25.1 MB' },
          { name: '📄 第02讲_虚拟内存管理与分页机制.pdf', size: '18.9 MB' },
          { name: '📄 第03讲_分布式一致性Raft算法.pdf', size: '27.3 MB' }
        ],
        videoFiles: [
          { name: '📹 第01讲_内核架构与中断处理机制_双路超清.mp4', size: '450 MB' },
          { name: '📹 第02讲_页表置换与虚拟内存管理_双路超清.mp4', size: '490 MB' },
          { name: '📹 第03讲_Raft共识算法原理剖析_双路超清.mp4', size: '530 MB' }
        ]
      },
      MATH1205: {
        code: 'MATH1205',
        name: '高等代数与解析几何',
        dept: '数学科学学院',
        slides: 28,
        videos: 12,
        sizeGb: 0.68,
        slidesFiles: [
          { name: '📄 第01讲_线性空间与基变换矩阵.pdf', size: '12.4 MB' },
          { name: '📄 第02讲_特征值与Jordan标准形.pdf', size: '15.8 MB' },
          { name: '📄 第03讲_欧几里得空间与正交变换.pdf', size: '14.6 MB' }
        ],
        videoFiles: [
          { name: '📹 第01讲_向量空间与维数定理_双路超清.mp4', size: '360 MB' },
          { name: '📹 第02讲_特征多项式与相似对角化_双路超清.mp4', size: '410 MB' },
          { name: '📹 第03讲_二次型与惯性定理_双路超清.mp4', size: '380 MB' }
        ]
      }
    };

    // 默认勾选 3 门课程 (CSE5001, SE3353, CS3502)
    const selectedCourseCodes = new Set(['CSE5001', 'SE3353', 'CS3502']);
    const islandSummaryText = document.getElementById('island-summary-text');
    const colCoursesHeader = document.getElementById('col-courses-header');

    function syncSelectionState() {
      // 1. 同步网格视图卡片
      document.querySelectorAll<HTMLElement>('.sim-grid-card').forEach((card) => {
        const id = card.getAttribute('data-course-id');
        if (!id) return;
        const isSelected = selectedCourseCodes.has(id);
        const checkboxEl = card.querySelector('.sim-grid-checkbox');

        if (isSelected) {
          card.classList.add('border-sjtu-blue', 'bg-white', 'dark:bg-slate-900/90', 'shadow-sm', 'shadow-sjtu-blue/10');
          card.classList.remove('border-slate-200', 'dark:border-slate-800', 'bg-white/70', 'dark:bg-slate-900/50', 'opacity-70');
          if (checkboxEl) {
            checkboxEl.className = 'sim-grid-checkbox w-5 h-5 rounded-md flex items-center justify-center text-xs shrink-0 transition-colors bg-sjtu-blue text-white';
            checkboxEl.textContent = '✓';
          }
        } else {
          card.classList.remove('border-sjtu-blue', 'bg-white', 'dark:bg-slate-900/90', 'shadow-sm', 'shadow-sjtu-blue/10');
          card.classList.add('border-slate-200', 'dark:border-slate-800', 'bg-white/70', 'dark:bg-slate-900/50', 'opacity-70');
          if (checkboxEl) {
            checkboxEl.className = 'sim-grid-checkbox w-5 h-5 rounded-md flex items-center justify-center text-xs shrink-0 transition-colors border border-slate-300 dark:border-slate-700';
            checkboxEl.textContent = '';
          }
        }
      });

      // 2. 同步列表视图行
      document.querySelectorAll<HTMLTableRowElement>('.sim-list-row').forEach((row) => {
        const id = row.getAttribute('data-course-id');
        if (!id) return;
        const isSelected = selectedCourseCodes.has(id);
        const checkbox = row.querySelector<HTMLInputElement>('.sim-list-checkbox');

        if (checkbox) checkbox.checked = isSelected;
        if (isSelected) {
          row.classList.add('bg-blue-50/40', 'dark:bg-blue-950/20');
        } else {
          row.classList.remove('bg-blue-50/40', 'dark:bg-blue-950/20');
        }
      });

      // 3. 计算已选总容量并动态更新底栏与分栏表头
      let totalGb = 0;
      selectedCourseCodes.forEach((code) => {
        if (courseMeta[code]) totalGb += courseMeta[code].sizeGb;
      });

      const formattedSize = totalGb >= 1 ? `${totalGb.toFixed(2)} GB` : `${Math.round(totalGb * 1024)} MB`;
      if (islandSummaryText) {
        islandSummaryText.textContent = `✦ 已选 ${selectedCourseCodes.size} 门课程 (${formattedSize})`;
      }
      if (colCoursesHeader) {
        colCoursesHeader.textContent = `课程列表 (已选 ${selectedCourseCodes.size})`;
      }
    }

    // 绑定网格卡片点击切换
    document.querySelectorAll<HTMLElement>('.sim-grid-card').forEach((card) => {
      if (card.dataset.bound) return;
      card.dataset.bound = 'true';
      card.addEventListener('click', () => {
        const id = card.getAttribute('data-course-id');
        if (!id) return;
        if (selectedCourseCodes.has(id)) {
          selectedCourseCodes.delete(id);
        } else {
          selectedCourseCodes.add(id);
        }
        syncSelectionState();
      });
    });

    // 绑定列表行与 Checkbox 点击切换
    document.querySelectorAll<HTMLInputElement>('.sim-list-checkbox').forEach((cb) => {
      if (cb.dataset.bound) return;
      cb.dataset.bound = 'true';
      cb.addEventListener('click', (e) => {
        e.stopPropagation();
        const id = cb.getAttribute('data-course-id');
        if (!id) return;
        if (cb.checked) {
          selectedCourseCodes.add(id);
        } else {
          selectedCourseCodes.delete(id);
        }
        syncSelectionState();
      });
    });

    document.querySelectorAll<HTMLTableRowElement>('.sim-list-row').forEach((row) => {
      if (row.dataset.bound) return;
      row.dataset.bound = 'true';
      row.addEventListener('click', () => {
        const id = row.getAttribute('data-course-id');
        if (!id) return;
        if (selectedCourseCodes.has(id)) {
          selectedCourseCodes.delete(id);
        } else {
          selectedCourseCodes.add(id);
        }
        syncSelectionState();
      });
    });

    // 4. 分栏视图 (Miller Columns) 课程 + 分类二级下钻联动
    let activeColCourse = 'CSE5001';
    let activeColCategory: 'slides' | 'videos' = 'slides';

    const colCourseBtns = document.querySelectorAll<HTMLButtonElement>('.col-course-item');
    const colCatSlidesBtn = document.getElementById('col-cat-slides-btn');
    const colCatVideosBtn = document.getElementById('col-cat-videos-btn');
    const colCatSlidesText = document.getElementById('col-cat-slides-text');
    const colCatVideosText = document.getElementById('col-cat-videos-text');
    const colFilesHeader = document.getElementById('col-files-header');
    const colFileList = document.getElementById('col-file-list');

    function renderColumnFiles() {
      const current = courseMeta[activeColCourse] || courseMeta['CSE5001'];

      // 更新分类数量徽标
      if (colCatSlidesText) {
        colCatSlidesText.textContent = `📁 课堂讲义与课件资料 (${current.slides})`;
      }
      if (colCatVideosText) {
        colCatVideosText.textContent = `🎬 课堂双路超清录播 (${current.videos})`;
      }

      // 更新分类选中状态样式
      if (colCatSlidesBtn && colCatVideosBtn) {
        if (activeColCategory === 'slides') {
          colCatSlidesBtn.className = 'col-cat-btn w-full text-left p-2 rounded-lg bg-slate-200 dark:bg-slate-800 font-medium flex justify-between items-center text-xs cursor-pointer transition-colors';
          colCatVideosBtn.className = 'col-cat-btn w-full text-left p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 font-medium flex justify-between items-center text-xs cursor-pointer transition-colors';
          if (colFilesHeader) colFilesHeader.textContent = '文件列表 (已勾选全部课件)';
        } else {
          colCatVideosBtn.className = 'col-cat-btn w-full text-left p-2 rounded-lg bg-slate-200 dark:bg-slate-800 font-medium flex justify-between items-center text-xs cursor-pointer transition-colors';
          colCatSlidesBtn.className = 'col-cat-btn w-full text-left p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 font-medium flex justify-between items-center text-xs cursor-pointer transition-colors';
          if (colFilesHeader) colFilesHeader.textContent = '文件列表 (已勾选全部录播)';
        }
      }

      // 渲染第三栏文件明细
      const filesToRender = activeColCategory === 'slides' ? current.slidesFiles : current.videoFiles;
      if (colFileList) {
        colFileList.innerHTML = filesToRender
          .map(
            (f) => `
          <div class="p-1.5 rounded flex items-center justify-between text-[11px] bg-blue-50/60 dark:bg-blue-950/30">
            <span class="truncate">${f.name}</span>
            <span class="text-slate-400 font-mono">${f.size}</span>
          </div>
        `
          )
          .join('');
      }
    }

    colCourseBtns.forEach((btn) => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = 'true';
      btn.addEventListener('click', () => {
        const code = btn.getAttribute('data-course');
        if (!code || !courseMeta[code]) return;

        colCourseBtns.forEach((b) => {
          b.className = 'col-course-item w-full text-left p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 font-medium flex justify-between items-center cursor-pointer text-xs transition-colors';
        });
        btn.className = 'col-course-item w-full text-left p-2 rounded-lg bg-sjtu-blue text-white font-medium flex justify-between items-center cursor-pointer text-xs transition-colors';

        activeColCourse = code;
        renderColumnFiles();
      });
    });

    if (colCatSlidesBtn && !colCatSlidesBtn.dataset.bound) {
      colCatSlidesBtn.dataset.bound = 'true';
      colCatSlidesBtn.addEventListener('click', () => {
        activeColCategory = 'slides';
        renderColumnFiles();
      });
    }

    if (colCatVideosBtn && !colCatVideosBtn.dataset.bound) {
      colCatVideosBtn.dataset.bound = 'true';
      colCatVideosBtn.addEventListener('click', () => {
        activeColCategory = 'videos';
        renderColumnFiles();
      });
    }

    // 5. Apple HIG 悬浮动作岛「开始同步 ›」3 秒模拟演示 (带 2px 流光激光进度条与完成绿标)
    const simSyncBtn = document.getElementById('sim-sync-btn');
    const simSyncBtnText = document.getElementById('sim-sync-btn-text');
    const islandLaserProgress = document.getElementById('island-laser-progress');
    let isSimSyncing = false;

    if (simSyncBtn && simSyncBtnText && islandLaserProgress && !simSyncBtn.dataset.bound) {
      simSyncBtn.dataset.bound = 'true';
      simSyncBtn.addEventListener('click', () => {
        if (isSimSyncing) return;
        isSimSyncing = true;

        islandLaserProgress.classList.remove('opacity-0', 'w-0');
        islandLaserProgress.classList.add('opacity-100');
        islandLaserProgress.style.width = '30%';
        simSyncBtnText.textContent = '同步中 28% · 16.2 MB/s';

        setTimeout(() => {
          islandLaserProgress.style.width = '68%';
          simSyncBtnText.textContent = '同步中 64% · 18.4 MB/s';
        }, 800);

        setTimeout(() => {
          islandLaserProgress.style.width = '95%';
          simSyncBtnText.textContent = '同步中 95% · 21.0 MB/s';
        }, 1700);

        setTimeout(() => {
          islandLaserProgress.style.width = '100%';
          simSyncBtnText.textContent = '✓ 已完成本地与云盘同步';
          simSyncBtn.classList.remove('from-sjtu-navy', 'to-sjtu-blue');
          simSyncBtn.classList.add('bg-emerald-600');
        }, 2500);

        setTimeout(() => {
          islandLaserProgress.classList.add('opacity-0');
          islandLaserProgress.style.width = '0%';
          simSyncBtnText.textContent = '开始同步 ›';
          simSyncBtn.classList.add('from-sjtu-navy', 'to-sjtu-blue');
          simSyncBtn.classList.remove('bg-emerald-600');
          isSimSyncing = false;
        }, 4000);
      });
    }
  }

  // 页面加载或 Astro 页面切换时执行绑定
  setupInteractiveSimulator();
  document.addEventListener('astro:page-load', setupInteractiveSimulator);
</script>
