---
import {REPOSITORY_URL} from '../utils/releaseInfo';
const links=[['#preview','实际界面'],['#guide','怎么使用'],['#android','安卓应用'],['#downloads','下载']];
---
<header class="site-header"><div class="container header-inner">
  <a class="brand" href="#top"><img src="/app-icon.png" alt="" width="36" height="36"/><span>交大课程下载器<small>SJTU Course Downloader</small></span></a>
  <nav class="desktop-nav" aria-label="主导航">{links.map(([href,text])=><a href={href}>{text}</a>)}</nav>
  <div class="header-actions"><a class="source-link" href={REPOSITORY_URL}>GitHub ↗</a><button class="theme-toggle" type="button" aria-label="切换深浅主题" aria-pressed="false">◐</button>
    <details class="mobile-nav"><summary>菜单</summary><nav aria-label="手机导航">{links.map(([href,text])=><a href={href}>{text}</a>)}</nav></details>
  </div>
</div></header>
<script>
 const toggle=document.querySelector<HTMLButtonElement>('.theme-toggle');
 const update=()=>toggle?.setAttribute('aria-pressed',String(document.documentElement.classList.contains('dark')));
 update();toggle?.addEventListener('click',()=>{const dark=document.documentElement.classList.toggle('dark');try{localStorage.setItem('theme',dark?'dark':'light')}catch{}update()});
 document.querySelectorAll('.mobile-nav a').forEach(link=>link.addEventListener('click',()=>document.querySelector('.mobile-nav')?.removeAttribute('open')));
</script>
