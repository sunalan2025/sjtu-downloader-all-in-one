---
import {desktopRelease,androidRelease,formatSize} from '../utils/releaseInfo';
const macNote=desktopRelease.assets.some(a=>a.platform==='mac'&&a.arch==='x64')?'请按电脑芯片选择 macOS 架构，文件扩展名不代表芯片类型。':'当前 macOS 安装包均为 Apple Silicon（arm64），ZIP 不代表 Intel 版本。';
const releases=[['桌面端',desktopRelease],['安卓端',androidRelease]] as const;
---
<section id="downloads" class="download-band section" aria-labelledby="downloads-title"><div class="container"><div class="section-heading"><div><p class="eyebrow">选择适合设备的版本</p><h2 id="downloads-title">安装包都在这里。</h2></div><p>文件直接来自项目 GitHub Releases。<br/>桌面端与安卓端独立发布。</p></div>
 {releases.map(([label,release])=><div class="release-group"><div class="release-heading"><h3>{label} <span>v{release.version}</span></h3><a class="text-link" href={release.releaseUrl}>发布说明 ↗</a></div><div class="installer-list">{release.assets.map(asset=><article class="installer"><div><strong>{asset.label}</strong><span>{asset.format} · {formatSize(asset.bytes)}</span></div><div class="installer-actions"><a class="button secondary" href={asset.url} aria-label={'下载 '+asset.label+' '+asset.format}>下载 ↓</a>{asset.sha256&&<button class="copy-hash" type="button" data-sha={asset.sha256} aria-label={'复制 '+asset.filename+' 的 SHA256'}>复制校验和</button>}</div></article>)}</div><div class="release-footnote"><p>{label==='桌面端'?macNote:'安卓正式包沿用历史公开签名以兼容同签名旧版，请从本仓库下载。'}</p>{release.checksumsUrl&&<a href={release.checksumsUrl}>SHA256SUMS.txt ↗</a>}</div></div>)}
 <p id="copy-result" role="status" class="copy-result" aria-live="polite"></p>
</div></section>
<script>
 const result=document.querySelector<HTMLElement>('#copy-result')!;let clear:number|undefined;
 document.querySelectorAll<HTMLButtonElement>('[data-sha]').forEach(button=>button.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(button.dataset.sha!);result.textContent='校验和已复制。'}catch{result.textContent='无法自动复制，请打开 SHA256SUMS.txt 查看。'}clearTimeout(clear);clear=window.setTimeout(()=>result.textContent='',4000);}));
</script>
