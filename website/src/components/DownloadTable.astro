---
import Icons from './icons/Icons.astro';
import {
  CURRENT_RELEASE_VERSION,
  getAllPlatformMatrix
} from '../utils/releaseInfo';

export interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
const currentVersion = `v${CURRENT_RELEASE_VERSION}`;
const allAssets = getAllPlatformMatrix(null, CURRENT_RELEASE_VERSION);

// 4 核心平台分发展现：Windows (.exe), Mac ARM64, Mac Intel, Linux
const platformCards = [
  allAssets.find((a) => a.id === 'win-exe')!,
  allAssets.find((a) => a.id === 'mac-arm64')!,
  allAssets.find((a) => a.id === 'mac-x64')!,
  allAssets.find((a) => a.id === 'linux-appimage')!
].filter(Boolean);

const changelogHighlights = [
  {
    title: '官方教务 1~18 周排课同步与 Canvas 作业截止 DDL 预警',
    desc: '直接同步个人学期排课，作业逾期与截止倒计时智能预警，并支持一键导出为通用 ICS 日历文件。'
  },
  {
    title: 'PPT 讲义自动提取与合并导出',
    desc: '自动抓取课堂视频中的 PPT 演讲切片并合并导出为单份高清 PDF 讲义，并可保留原画质切片图。'
  },
  {
    title: '现代化三重视图自由切换 (网格 / 列表 / 分栏)',
    desc: '全功能支持网格大卡片、详细列表与三栏分栏（Miller Columns）逐级下钻视图，多课程浏览如丝顺滑。'
  },
  {
    title: '底栏 Apple HIG 悬浮智能指挥动作岛',
    desc: '统一整合下载出口，实时统计多门课程已选分类体积，提供课件、视频、作业与 PPT 芯片一键切换。'
  },
  {
    title: '系统级硬件安全保险库与防误操作',
    desc: '采用 Windows DPAPI / macOS Keychain 原生加密存储，自动填充绝不自动触发表单提交。'
  }
];
---

<section
  id="download"
  class={`py-20 sm:py-28 relative overflow-hidden ${className}`}
  aria-label="下载中心"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-14 sm:mb-16">
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white">
        全平台安装包
      </h2>
      <p class="mt-3 text-base text-slate-600 dark:text-slate-400">
        最新稳定版 <span class="font-mono font-bold text-sjtu-blue dark:text-blue-400">{currentVersion}</span> · 内置 FFmpeg 免配置 · 支持 SHA-256 校验
      </p>
    </div>

    <!-- 4 极简平台卡片 Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
      {
        platformCards.map((asset) => {
          const iconName = asset.platform === 'mac' ? 'apple' : asset.platform;
          return (
            <div
              class="group rounded-3xl p-6 sm:p-7 border border-slate-200/80 dark:border-slate-800 bg-white/80 dark:bg-slate-900/60 backdrop-blur-xl shadow-sm hover:shadow-xl hover:border-sjtu-blue/40 dark:hover:border-sjtu-blue/40 transition-all duration-300 flex flex-col justify-between"
            >
              <div>
                <div class="flex items-center justify-between mb-5">
                  <div class="w-11 h-11 rounded-2xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 flex items-center justify-center group-hover:text-sjtu-blue group-hover:bg-blue-50 dark:group-hover:bg-blue-950/60 transition-colors">
                    <Icons name={iconName} class="w-5 h-5" />
                  </div>
                  <span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-semibold bg-blue-50 dark:bg-blue-950/60 text-sjtu-blue dark:text-blue-300">
                    {asset.format}
                  </span>
                </div>

                <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-slate-100">
                  {asset.name}
                </h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
                  {asset.arch} · 约 {asset.sizeMb} MB
                </p>
              </div>

              <div class="mt-6 pt-4 border-t border-slate-100 dark:border-slate-800/80 space-y-3">
                <a
                  href={asset.url}
                  class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl text-xs font-bold bg-slate-900 hover:bg-sjtu-blue dark:bg-white dark:hover:bg-blue-400 text-white dark:text-slate-900 transition-colors shadow-sm"
                >
                  <Icons name="download" class="w-4 h-4" />
                  <span>立即下载</span>
                </a>

                <div class="flex items-center justify-between text-[11px] text-slate-400">
                  <span class="font-mono truncate max-w-[140px]" title={asset.sha256}>
                    SHA: {asset.sha256?.substring(0, 10)}...
                  </span>
                  <button
                    type="button"
                    class="copy-sha-btn text-sjtu-blue hover:underline cursor-pointer font-medium"
                    data-hash={asset.sha256}
                  >
                    复制哈希
                  </button>
                </div>
              </div>
            </div>
          );
        })
      }
    </div>

    <!-- 📋 v2.5.0 版本更新日志折叠抽屉 -->
    <div class="max-w-4xl mx-auto">
      <details class="group rounded-2xl bg-white/70 dark:bg-slate-900/50 border border-slate-200/80 dark:border-slate-800 shadow-sm transition-all duration-200">
        <summary class="flex items-center justify-between p-5 cursor-pointer list-none select-none text-left rounded-2xl focus:outline-none">
          <div class="flex items-center gap-3">
            <div class="w-7 h-7 rounded-lg bg-blue-50 dark:bg-blue-950/60 text-sjtu-blue dark:text-blue-300 flex items-center justify-center text-xs font-bold">
              ✦
            </div>
            <div>
              <span class="text-sm font-bold text-slate-900 dark:text-white">
                查看 {currentVersion} 详细更新日志 (Changelog)
              </span>
              <span class="text-xs text-slate-400 ml-2 hidden sm:inline">全平台架构与特性升级</span>
            </div>
          </div>
          <span class="text-xs text-slate-500 dark:text-slate-400 transition-transform duration-200 group-open:rotate-180">
            <Icons name="chevron-down" class="w-4 h-4" />
          </span>
        </summary>
        <div class="px-5 pb-5 pt-1 text-xs text-slate-600 dark:text-slate-300 border-t border-slate-100 dark:border-slate-800/60 mt-1">
          <div class="space-y-3 pt-3">
            {
              changelogHighlights.map((log) => (
                <div class="flex items-start gap-2.5">
                  <span class="text-sjtu-blue mt-0.5">•</span>
                  <div>
                    <div class="font-bold text-slate-800 dark:text-slate-200">{log.title}</div>
                    <div class="text-slate-500 dark:text-slate-400 mt-0.5">{log.desc}</div>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </details>
    </div>
  </div>

  <!-- 浮动复制反馈 Toast 气泡 -->
  <div
    id="sha-toast"
    class="fixed bottom-6 right-6 z-50 transform translate-y-24 opacity-0 pointer-events-none transition-all duration-300 flex items-center gap-2 px-4 py-2.5 rounded-xl bg-slate-900/90 dark:bg-white/90 text-white dark:text-slate-900 text-xs font-medium shadow-2xl backdrop-blur-md"
  >
    <Icons name="check" class="w-4 h-4 text-emerald-400 dark:text-emerald-600" />
    <span>已复制 SHA-256 校验码到剪贴板</span>
  </div>
</section>

<script>
  function setupShaCopy() {
    const copyBtns = document.querySelectorAll<HTMLButtonElement>('.copy-sha-btn');
    const toast = document.getElementById('sha-toast');

    copyBtns.forEach((btn) => {
      btn.addEventListener('click', async () => {
        const hash = btn.getAttribute('data-hash');
        if (!hash) return;

        try {
          await navigator.clipboard.writeText(hash);
          if (toast) {
            toast.classList.remove('translate-y-24', 'opacity-0', 'pointer-events-none');
            toast.classList.add('translate-y-0', 'opacity-100');
            setTimeout(() => {
              toast.classList.add('translate-y-24', 'opacity-0', 'pointer-events-none');
              toast.classList.remove('translate-y-0', 'opacity-100');
            }, 2500);
          }
        } catch {
          // fallback
        }
      });
    });
  }

  setupShaCopy();
  document.addEventListener('astro:page-load', setupShaCopy);
</script>
