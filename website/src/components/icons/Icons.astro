---
import type { IconName } from './types';
export type { IconName };

export interface Props {
  name: IconName;
  class?: string;
  size?: number | string;
}

const { name, class: className = 'w-5 h-5', size } = Astro.props;

const key = name.toLowerCase().replace(/[-_]/g, '');
---

{
  key === 'windows' && (
    <svg viewBox="0 0 24 24" width={size} height={size} fill="currentColor" class={className} aria-hidden="true">
      <path d="M3 3h8v8H3V3zm10 0h8v8h-8V3zM3 13h8v8H3v-8zm10 0h8v8h-8v-8z" />
    </svg>
  )
}

{
  key === 'apple' && (
    <svg viewBox="0 0 24 24" width={size} height={size} fill="currentColor" class={className} aria-hidden="true">
      <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.37c.63-.78 1.06-1.85.94-2.94-.93.04-2.03.62-2.69 1.4-.58.67-1.1 1.76-.96 2.82 1.04.08 2.08-.5 2.71-1.28z" />
    </svg>
  )
}

{
  key === 'linux' && (
    <svg viewBox="0 0 24 24" width={size} height={size} fill="currentColor" class={className} aria-hidden="true">
      <path d="M12.002 0c-3.136 0-5.717 2.528-5.717 5.71 0 1.344.475 2.728 1.22 3.73-.243.468-.69 1.228-1.263 2.096-.88 1.332-2.043 2.94-2.167 4.582-.068.908.165 1.769.7 2.415.6.723 1.55 1.077 2.718 1.077.742 0 1.55-.14 2.363-.414.736.357 1.458.532 2.052.532.593 0 1.316-.175 2.052-.532.813.274 1.621.414 2.363.414 1.168 0 2.118-.354 2.718-1.077.535-.646.768-1.507.7-2.415-.124-1.642-1.287-3.25-2.167-4.582-.573-.868-1.02-1.628-1.263-2.096.745-1.002 1.22-2.386 1.22-3.73C17.719 2.528 15.138 0 12.002 0z" />
    </svg>
  )
}

{
  key === 'github' && (
    <svg viewBox="0 0 24 24" width={size} height={size} fill="currentColor" class={className} aria-hidden="true">
      <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
    </svg>
  )
}

{
  key === 'download' && (
    <svg viewBox="0 0 24 24" width={size} height={size} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
      <polyline points="7 10 12 15 17 10" />
      <line x1="12" y1="15" x2="12" y2="3" />
    </svg>
  )
}

{
  key === 'shield' && (
    <svg viewBox="0 0 24 24" width={size} height={size} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
