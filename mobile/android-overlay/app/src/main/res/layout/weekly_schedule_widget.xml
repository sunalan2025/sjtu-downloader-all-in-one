<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:id="@+id/week_widget_root" xmlns:android="http://schemas.android.com/apk/res/android"
    android:forceDarkAllowed="false" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/today_widget_surface"
    android:paddingLeft="8dp" android:paddingRight="8dp"
    android:paddingTop="10dp" android:paddingBottom="7dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/week_time_axis_title" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="本周日程"
            android:textSize="15sp" android:textColor="@color/sjtu_widget_on_surface"
            android:letterSpacing="0.01" android:textStyle="bold"/>
        <TextView android:id="@+id/week_range" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="10sp"
            android:gravity="end" android:maxLines="2" android:layout_marginLeft="8dp"
            android:textStyle="bold" android:textColor="@color/sjtu_widget_on_surface"/>
    </LinearLayout>
    <TextView android:id="@+id/week_focus" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="38dp"
        android:layout_marginTop="6dp" android:layout_marginBottom="8dp"
        android:gravity="center_vertical" android:paddingLeft="13dp"
        android:paddingRight="10dp" android:paddingTop="6dp"
        android:paddingBottom="6dp" android:textSize="12sp"
        android:textStyle="bold" android:maxLines="3"
        android:ellipsize="end" android:textColor="@color/sjtu_widget_on_surface"
        android:background="@drawable/week_widget_focus_surface"
        android:text="正在同步本周课程…"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="43dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@android:color/transparent"
        android:paddingLeft="1dp" android:paddingRight="1dp"
        android:layout_marginBottom="4dp">
        <TextView android:id="@+id/week_time_axis_label" android:layout_width="36dp" android:layout_height="match_parent"
            android:gravity="center" android:text="时间"
            android:textSize="9sp" android:textColor="@color/sjtu_widget_on_surface"/>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="43dp" android:gravity="center"
            android:orientation="vertical" android:padding="1dp"
            android:background="@android:color/transparent">
            <TextView android:id="@+id/week_day_mon" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:gravity="center"
                android:text="一" android:textStyle="bold" android:textSize="11sp"
                android:textColor="@color/sjtu_widget_on_surface"/>
            <TextView android:id="@+id/week_date_mon" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:gravity="center"
                android:textSize="9sp" android:textColor="@color/sjtu_widget_on_surface"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="43dp" android:gravity="center"
            android:orientation="vertical" android:padding="1dp"
            android:background="@android:color/transparent">
            <TextView android:id="@+id/week_day_tue" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:gravity="center"
                android:text="二" android:textStyle="bold" android:textSize="11sp"
                android:textColor="@color/sjtu_widget_on_surface"/>
            <TextView android:id="@+id/week_date_tue" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:gravity="center"
                android:textSize="9sp" android:textColor="@color/sjtu_widget_on_surface"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="43dp" android:gravity="center"
            android:orientation="vertical" android:padding="1dp"
            android:background="@android:color/transparent">
            <TextView android:id="@+id/week_day_wed" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:gravity="center"
                android:text="三" android:textStyle="bold" android:textSize="11sp"
                android:textColor="@color/sjtu_widget_on_surface"/>
            <TextView android:id="@+id/week_date_wed" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:gravity="center"
                android:textSize="9sp" android:textColor="@color/sjtu_widget_on_surface"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="43dp" android:gravity="center"
            android:orientation="vertical" android:padding="1dp"
            android:background="@android:color/transparent">
            <TextView android:id="@+id/week_day_thu" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:gravity="center"
                android:text="四" android:textStyle="bold" android:textSize="11sp"
                android:textColor="@color/sjtu_widget_on_surface"/>
            <TextView android:id="@+id/week_date_thu" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:gravity="center"
                android:textSize="9sp" android:textColor="@color/sjtu_widget_on_surface"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="43dp" android:gravity="center"
            android:orientation="vertical" android:padding="1dp"
            android:background="@android:color/transparent">
            <TextView android:id="@+id/week_day_fri" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:gravity="center"
                android:text="五" android:textStyle="bold" android:textSize="11sp"
                android:textColor="@color/sjtu_widget_on_surface"/>
            <TextView android:id="@+id/week_date_fri" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:gravity="center"
                android:textSize="9sp" android:textColor="@color/sjtu_widget_on_surface"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="43dp" android:gravity="center"
            android:orientation="vertical" android:padding="1dp"
            android:background="@android:color/transparent">
            <TextView android:id="@+id/week_day_sat" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:gravity="center"
                android:text="六" android:textStyle="bold" android:textSize="11sp"
                android:textColor="@color/sjtu_widget_on_surface"/>
            <TextView android:id="@+id/week_date_sat" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:gravity="center"
                android:textSize="9sp" android:textColor="@color/sjtu_widget_on_surface"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="43dp" android:gravity="center"
            android:orientation="vertical" android:padding="1dp"
            android:background="@android:color/transparent">
            <TextView android:id="@+id/week_day_sun" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:gravity="center"
                android:text="日" android:textStyle="bold" android:textSize="11sp"
                android:textColor="@color/sjtu_widget_on_surface"/>
            <TextView android:id="@+id/week_date_sun" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:gravity="center"
                android:textSize="9sp" android:textColor="@color/sjtu_widget_on_surface"/>
        </LinearLayout>
    </LinearLayout>
    <ListView android:id="@+id/week_list" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1"
        android:clipToPadding="false"
        android:divider="@android:color/transparent" android:dividerHeight="0dp"
        android:scrollbars="vertical" android:fadeScrollbars="true"
        android:drawSelectorOnTop="false"
        android:background="@android:color/transparent"/>
    <TextView android:id="@+id/week_empty"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:gravity="center"
        android:text="本周暂无日程"
        android:textColor="@color/sjtu_widget_on_surface" android:textSize="12sp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="21dp"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/week_legend" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="课程独立配色 · 浅红为考试"
            android:textSize="9sp" android:textColor="@color/sjtu_widget_on_surface"/>
        <TextView android:id="@+id/week_scroll_hint" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="上下滑动时间轴" android:textSize="9sp"
            android:textColor="@color/sjtu_widget_on_surface"/>
    </LinearLayout>
</LinearLayout>
