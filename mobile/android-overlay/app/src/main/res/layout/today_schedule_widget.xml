<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/today_widget_surface"
    android:paddingLeft="17dp"
    android:paddingRight="17dp"
    android:paddingTop="13dp"
    android:paddingBottom="13dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="●  SJTU · 今日课表"
            android:textColor="#3A72AF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"/>
        <TextView
            android:id="@+id/widget_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="11月1日 周日"
            android:textColor="#758CA8"
            android:textSize="10sp"
            android:singleLine="true"/>
    </LinearLayout>
    <TextView
        android:id="@+id/widget_badge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="下一节课 · 08:00"
        android:textColor="#397AB7"
        android:textSize="11sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:ellipsize="end"/>
    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="打开应用同步今天的课程"
        android:textColor="#253C5B"
        android:textSize="18sp"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end"/>
    <TextView
        android:id="@+id/widget_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textColor="#617F9D"
        android:textSize="11sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="08:00–09:40 · 教室"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1F6596CC"
        android:layout_marginTop="7dp"
        android:layout_marginBottom="8dp"/>
    <TextView
        android:id="@+id/widget_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="下一节课程提示"
        android:textColor="#5D7792"
        android:textSize="11sp"
        android:maxLines="2"
        android:ellipsize="end"/>
</LinearLayout>
