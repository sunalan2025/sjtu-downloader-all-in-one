<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_fallback_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/today_widget_surface"
    android:padding="18dp">
    <TextView android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="SJTU · 今日课表"
        android:textSize="13sp" android:textStyle="bold"
        android:textColor="#346FAE"/>
    <TextView android:id="@+id/widget_fallback_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="打开应用同步桌面组件"
        android:textSize="12sp"
        android:lineSpacingExtra="4dp"
        android:textColor="#344E72"/>
</LinearLayout>
