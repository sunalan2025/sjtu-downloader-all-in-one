<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="SJTUMaterialDialog" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">#FAF9FD</item>
        <item name="android:statusBarColor">#00000000</item>
        <item name="android:navigationBarColor">#00000000</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorAccent">#005AC1</item>
        <item name="android:fontFamily">sans</item>
    </style>
    <style name="SJTUMaterialDialog.Dark" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">#131316</item>
        <item name="android:statusBarColor">#00000000</item>
        <item name="android:navigationBarColor">#00000000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">#ADC6FF</item>
        <item name="android:fontFamily">sans</item>
    </style>
    <style name="SJTUMaterialDialogAnimation">
        <item name="android:windowEnterAnimation">@anim/sjtu_dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/sjtu_dialog_exit</item>
    </style>
</resources>
