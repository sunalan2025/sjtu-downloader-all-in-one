{
  "name": "sjtu-downloader-android",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "android:prepare": "node scripts/prepare-android.mjs",
    "android:debug": "npm run build && npm run android:prepare && cd android && ./gradlew assembleDebug",
    "prebuild": "node scripts/prepare-brand.mjs",
    "predev": "node scripts/prepare-brand.mjs",
    "android:icons": "node scripts/generate-android-icons.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@capacitor/app": "^7.1.0",
    "@capacitor/haptics": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "sharp": "^0.34.3"
  }
}
